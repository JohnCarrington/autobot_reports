+"""day_type_adapter.py — Canonical day-type field for the orchestrator.
+
+Per Phase 1 §13.
+
+Two runtime modules produce overlapping day-type labels today:
+    calendar_day_type.classify_date(iso) -> label ∈
+        {"BIG_NEWS", "PRE_NEWS", "POST_NEWS", "NORMAL"}  (plus dual_labels)
+    day_context.current(now_utc)         -> label ∈
+        {"BIG_NEWS", "PRE_BIG", "POST_BIG", "CLEAR"}
+
+The authoritative future vocabulary per spec §4 is:
+    BIG_NEWS
+    BIG_NEWS_MINUS_1
+    BIG_NEWS_PLUS_1
+    MID_NEWS
+    NORMAL
+
+Phase 1 rules (spec §13):
+    * preserve raw labels (available in the returned dict)
+    * normalise obvious equivalents
+    * log disagreement (structured, not fatal)
+    * do NOT invent MID_NEWS on a day where the mapper does not currently
+      provide it — MID_NEWS synthesis is a Phase 2 task
+
+Normalisation table:
+    calendar_day_type.PRE_NEWS   ↔ day_context.PRE_BIG   → BIG_NEWS_MINUS_1
+    calendar_day_type.POST_NEWS  ↔ day_context.POST_BIG  → BIG_NEWS_PLUS_1
+    calendar_day_type.BIG_NEWS   ↔ day_context.BIG_NEWS  → BIG_NEWS
+    calendar_day_type.NORMAL     ↔ day_context.CLEAR     → NORMAL
+
+MIDDLE tier detection: this adapter DOES surface the MIDDLE tier when
+either module reports it, but flags it with mid_news_available=False when
+mapping is absent (spec §13 forbids invention). Phase 2 will teach the
+calendar mapper to emit MID_NEWS; until then the adapter is honest.
+
+Disagreements between modules are logged to logs/day_type_adapter.jsonl
+(append-only, best-effort). Never raises.
+
+Zero admission-side authority: this module returns a data dict. It never
+gates a trade.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+# Canonical labels (future vocabulary per spec §4)
+CANON_BIG_NEWS         = "BIG_NEWS"
+CANON_BIG_NEWS_MINUS_1 = "BIG_NEWS_MINUS_1"
+CANON_BIG_NEWS_PLUS_1  = "BIG_NEWS_PLUS_1"
+CANON_MID_NEWS         = "MID_NEWS"
+CANON_NORMAL           = "NORMAL"
+CANON_UNKNOWN          = "UNKNOWN"
+
+_CANON_ALL = frozenset({
+    CANON_BIG_NEWS, CANON_BIG_NEWS_MINUS_1, CANON_BIG_NEWS_PLUS_1,
+    CANON_MID_NEWS, CANON_NORMAL, CANON_UNKNOWN,
+})
+
+# calendar_day_type → canonical mapping
+_CDT_MAP = {
+    "BIG_NEWS":  CANON_BIG_NEWS,
+    "PRE_NEWS":  CANON_BIG_NEWS_MINUS_1,
+    "POST_NEWS": CANON_BIG_NEWS_PLUS_1,
+    "NORMAL":    CANON_NORMAL,
+}
+
+# day_context → canonical mapping
+_DCX_MAP = {
+    "BIG_NEWS": CANON_BIG_NEWS,
+    "PRE_BIG":  CANON_BIG_NEWS_MINUS_1,
+    "POST_BIG": CANON_BIG_NEWS_PLUS_1,
+    "CLEAR":    CANON_NORMAL,
+}
+
+_LOG_PATH = Path(os.getenv(
+    "DAY_TYPE_ADAPTER_LOG_PATH",
+    "/opt/tradingbot/logs/day_type_adapter.jsonl",
+))
+
+
+def _append_log(row: Dict[str, Any]) -> None:
+    """Best-effort append. Failures are swallowed — this is telemetry."""
+    try:
+        _LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
+        with _LOG_PATH.open("a", encoding="utf-8") as fh:
+            fh.write(json.dumps(row, sort_keys=True) + "\n")
+    except Exception as exc:
+        logger.debug("[day_type_adapter] log write failed: %s", exc)
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def resolve(now_utc: Optional[datetime] = None) -> Dict[str, Any]:
+    """Return the canonical day-type + raw labels + disagreement flag.
+
+    Returns:
+        {
+          "canonical": str,        # one of CANON_*
+          "mid_news_available": bool,
+          "raw_calendar_day_type": Optional[dict],
+          "raw_day_context": Optional[dict],
+          "disagreement": bool,
+          "as_of": str,
+          "notes": [str],
+        }
+
+    Never raises. On total failure returns a CANON_UNKNOWN snapshot.
+    """
+    notes: list = []
+    if now_utc is None:
+        now_utc = datetime.now(timezone.utc)
+
+    # calendar_day_type read
+    cdt_raw: Optional[Dict[str, Any]] = None
+    try:
+        import calendar_day_type as _cdt
+        iso = now_utc.astimezone(timezone.utc).strftime("%Y-%m-%d")
+        cdt_raw = _cdt.classify_date(iso)
+    except Exception as exc:
+        notes.append(f"cdt_read_failed:{type(exc).__name__}")
+
+    # day_context read
+    dcx_raw: Optional[Dict[str, Any]] = None
+    try:
+        import day_context as _dcx
+        dcx_raw = _dcx.current(now_utc)
+    except Exception as exc:
+        notes.append(f"dcx_read_failed:{type(exc).__name__}")
+
+    cdt_label = (cdt_raw or {}).get("label")
+    dcx_label = (dcx_raw or {}).get("label")
+
+    cdt_canon = _CDT_MAP.get(str(cdt_label or "").upper(), CANON_UNKNOWN)
+    dcx_canon = _DCX_MAP.get(str(dcx_label or "").upper(), CANON_UNKNOWN)
+
+    # Resolution: prefer non-UNKNOWN; if both known and disagree, prefer
+    # BIG_NEWS > BIG_NEWS_MINUS_1 > BIG_NEWS_PLUS_1 > NORMAL and flag
+    # disagreement. This preserves the more conservative label (BIG_NEWS
+    # wins) rather than silently discarding one source.
+    priority = {
+        CANON_BIG_NEWS: 4,
+        CANON_BIG_NEWS_MINUS_1: 3,
+        CANON_BIG_NEWS_PLUS_1: 2,
+        CANON_NORMAL: 1,
+        CANON_UNKNOWN: 0,
+        CANON_MID_NEWS: 3,   # equivalent priority to MINUS_1
+    }
+
+    if cdt_canon == CANON_UNKNOWN and dcx_canon == CANON_UNKNOWN:
+        canonical = CANON_UNKNOWN
+    else:
+        canonical = cdt_canon if priority[cdt_canon] >= priority[dcx_canon] else dcx_canon
+
+    disagreement = (
+        cdt_canon != CANON_UNKNOWN
+        and dcx_canon != CANON_UNKNOWN
+        and cdt_canon != dcx_canon
+    )
+
+    # MID_NEWS availability: neither module produces MID_NEWS today.
+    # Spec §13 forbids invention; the adapter honestly reports False.
+    mid_news_available = False
+
+    out = {
+        "canonical": canonical,
+        "mid_news_available": mid_news_available,
+        "raw_calendar_day_type": cdt_raw,
+        "raw_day_context": dcx_raw,
+        "disagreement": disagreement,
+        "as_of": now_utc.astimezone(timezone.utc).isoformat(),
+        "notes": notes,
+    }
+
+    if disagreement:
+        _append_log({
+            "ts": _now_iso(),
+            "event": "disagreement",
+            "cdt_label": cdt_label,
+            "cdt_canon": cdt_canon,
+            "dcx_label": dcx_label,
+            "dcx_canon": dcx_canon,
+            "resolved_to": canonical,
+        })
+    return out
