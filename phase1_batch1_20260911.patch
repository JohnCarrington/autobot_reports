+"""Phase 1 §13 day_type_adapter tests."""
+from __future__ import annotations
+
+import pytest
+
+import day_type_adapter as _dta
+
+
+def test_canonical_labels_are_all_declared():
+    for label in (
+        _dta.CANON_BIG_NEWS, _dta.CANON_BIG_NEWS_MINUS_1,
+        _dta.CANON_BIG_NEWS_PLUS_1, _dta.CANON_MID_NEWS,
+        _dta.CANON_NORMAL, _dta.CANON_UNKNOWN,
+    ):
+        assert isinstance(label, str) and label
+
+
+def test_resolve_never_raises_even_when_sources_fail(monkeypatch):
+    """Even if both underlying modules explode, resolve() must return
+    a dict, not raise. The adapter is telemetry, not gating."""
+
+    def _boom(*_a, **_kw):
+        raise RuntimeError("simulated")
+
+    import calendar_day_type as _cdt
+    import day_context as _dcx
+    monkeypatch.setattr(_cdt, "classify_date", _boom)
+    monkeypatch.setattr(_dcx, "current", _boom)
+
+    out = _dta.resolve()
+    assert out["canonical"] == _dta.CANON_UNKNOWN
+    assert any("read_failed" in n for n in out["notes"])
+
+
+def test_mid_news_not_invented(monkeypatch):
+    """Phase 1 §13: adapter must NOT invent MID_NEWS. It should report
+    mid_news_available=False until Phase 2 wires the mapper."""
+    out = _dta.resolve()
+    assert out["mid_news_available"] is False
+    assert out["canonical"] != _dta.CANON_MID_NEWS
