+"""candidate.py — Canonical Candidate contract for Phase 1 orchestrator.
+
+Per master_spec_20260911.md §3 and Phase 1 §3.
+
+A Candidate represents a DETECTION only. It says "I detect an opportunity."
+It never says "I am allowed to trade." Only the CentralExecutionGate can
+approve an execution.
+
+Contract invariants:
+  * Candidates are immutable dataclasses (frozen=True).
+  * No Candidate constructor may place an order, amend a stop, or produce
+    any side effect. Instantiation must be pure.
+  * strategy_family is a bounded vocabulary (see FAMILY_* constants).
+  * opportunity_type is a bounded vocabulary (see OPPORTUNITY_* constants).
+  * source_path is a bounded vocabulary (see SOURCE_* constants).
+  * day_type_raw preserves the raw calendar/day_context label without
+    normalisation (canonical mapping happens in day_type_adapter.py; the
+    raw label is preserved for audit).
+  * market_state_snapshot is a shallow dict — no callable, no live object.
+  * reason_codes is a list of str; readers rely on membership tests.
+  * mechanical_valid is False when the detector emits a candidate that
+    fails its own basic mechanical prechecks (e.g. NaN price). The gate
+    STILL sees it (for corpus completeness) but rejects with
+    reason_codes=['mechanical_invalid'].
+
+Nothing in this module reads env vars, imports strategies, or touches
+disk. Adapters that wrap existing StrategyDecision objects live in
+orchestrator_v2 (never here) so this file has zero runtime dependency.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field, replace
+from typing import Any, Dict, List, Optional, Tuple
+
+# ── Bounded vocabularies ───────────────────────────────────────────────────
+# Kept as string constants (not Enums) so JSON serialisation is trivial and
+# the corpus writer can round-trip via json.dumps/loads without adapters.
+
+# strategy_family — coarse grouping used by the orchestrator's future
+# permission matrix (spec §41). Not enforced yet — Phase 1 preserves
+# whatever family label the detector reports.
+FAMILY_BB_BOUNCE          = "BB_BOUNCE"
+FAMILY_LEVEL_BOUNCE       = "LEVEL_BOUNCE"
+FAMILY_EMA_PULLBACK       = "EMA_PULLBACK"
+FAMILY_STRUCTURE_BREAK    = "STRUCTURE_BREAK"
+FAMILY_TREND_V3           = "TREND_V3"
+FAMILY_BRIEFING_EXECUTION = "BRIEFING_EXECUTION"
+FAMILY_BRIEFING_V5        = "BRIEFING_V5"
+FAMILY_BRIEFING_LIQUIDITY = "BRIEFING_LIQUIDITY"
+FAMILY_BRIEFING_SWEEP     = "BRIEFING_SWEEP"
+FAMILY_BRIEFING_HUNT      = "BRIEFING_HUNT"
+FAMILY_PIA_FIRST          = "PIA_FIRST"
+FAMILY_NEWS_STRATEGY      = "NEWS_STRATEGY"
+FAMILY_NEWS_TICK          = "NEWS_TICK"
+FAMILY_NEWS_CONTINUATION  = "NEWS_CONTINUATION"
+FAMILY_PIVOT_BREAK        = "PIVOT_BREAK"
+FAMILY_H1_PIERCE          = "H1_PIERCE"
+FAMILY_CONFIRMATION_FALLBACK = "CONFIRMATION_FALLBACK"
+FAMILY_BB_REVERSAL_PATTERNS  = "BB_REVERSAL_PATTERNS"
+FAMILY_QM_V2              = "QM_V2"
+FAMILY_LIQUIDITY_SWEEP    = "LIQUIDITY_SWEEP"
+FAMILY_WINDOW_SWEEP       = "WINDOW_SWEEP"
+FAMILY_UNKNOWN            = "UNKNOWN"
+
+# opportunity_type — what kind of price behaviour the detector claims to
+# see. Kept coarse in Phase 1; the routing phase refines it.
+OPPORTUNITY_TREND_CONTINUATION = "TREND_CONTINUATION"
+OPPORTUNITY_TREND_PULLBACK     = "TREND_PULLBACK"
+OPPORTUNITY_BOUNCE             = "BOUNCE"
+OPPORTUNITY_REVERSAL           = "REVERSAL"
+OPPORTUNITY_BREAKOUT           = "BREAKOUT"
+OPPORTUNITY_LIQUIDITY_SWEEP    = "LIQUIDITY_SWEEP"
+OPPORTUNITY_NEWS_FADE          = "NEWS_FADE"
+OPPORTUNITY_NEWS_CONTINUATION  = "NEWS_CONTINUATION"
+OPPORTUNITY_BRIEFING_PLAN      = "BRIEFING_PLAN"
+OPPORTUNITY_UNKNOWN            = "UNKNOWN"
+
+# source_path — which existing dispatch site produced the candidate.
+# Used by the orchestrator to know which legacy path a candidate came
+# from during the migration window. Once a path is fully migrated the
+# label is retained purely for corpus provenance.
+SOURCE_TICK_CASCADE            = "TICK_CASCADE"
+SOURCE_5M_CLOSE_BB_BOUNCE      = "5M_CLOSE_BB_BOUNCE"
+SOURCE_5M_CLOSE_EMA_PULLBACK   = "5M_CLOSE_EMA_PULLBACK"
+SOURCE_5M_CLOSE_STRUCTURE_BREAK = "5M_CLOSE_STRUCTURE_BREAK"
+SOURCE_5M_CLOSE_BB_REV_PAT     = "5M_CLOSE_BB_REV_PAT"
+SOURCE_5M_CLOSE_CONF_FALLBACK  = "5M_CLOSE_CONFIRMATION_FALLBACK"
+SOURCE_5M_CLOSE_PIVOT_BREAK    = "5M_CLOSE_PIVOT_BREAK"
+SOURCE_5M_CLOSE_LEVEL_BOUNCE   = "5M_CLOSE_LEVEL_BOUNCE"
+SOURCE_5M_CLOSE_H1_PIERCE      = "5M_CLOSE_H1_PIERCE"
+SOURCE_5M_CLOSE_TREND_V3       = "5M_CLOSE_TREND_V3"
+SOURCE_NEWS_TICK               = "NEWS_TICK"
+SOURCE_NEWS_STRATEGY           = "NEWS_STRATEGY"
+SOURCE_NEWS_CONTINUATION       = "NEWS_CONTINUATION"
+SOURCE_BRIEFING_V4             = "BRIEFING_V4"
+SOURCE_BRIEFING_V5             = "BRIEFING_V5"
+SOURCE_PIA_FIRST               = "PIA_FIRST"
+SOURCE_QM_V2                   = "QM_V2"
+SOURCE_ROUTER_ENGINE           = "ROUTER_ENGINE_LEGACY"  # dark path — retained for parity
+SOURCE_REPLAY                  = "REPLAY"                # for parity harness only
+SOURCE_UNKNOWN                 = "UNKNOWN"
+
+# side vocabulary
+SIDE_LONG  = "LONG"
+SIDE_SHORT = "SHORT"
+
+_VALID_SIDES = frozenset({SIDE_LONG, SIDE_SHORT})
+
+
+@dataclass(frozen=True)
+class Candidate:
+    """Canonical opportunity detection.
+
+    Fields marked "required" (no default) MUST be supplied — a Candidate
+    with a missing required field is a defect and the constructor will
+    raise ValueError via __post_init__.
+
+    Fields marked "context" hold market/day state as of the detection
+    instant. They are captured by value (a shallow dict copy) so later
+    grading can reason about what the detector actually saw without
+    depending on any live object state.
+
+    See spec §3 for the required-field list.
+    """
+
+    # ── Identity ──────────────────────────────────────────────────────────
+    candidate_id: str                     # required — unique per detection
+    timestamp: str                        # ISO-8601 UTC of first detection
+    epic: str                             # IG epic (e.g. "CS.D.GBPUSD.TODAY.IP")
+    pair: str                             # normalised pair (e.g. "GBPUSD")
+
+    # ── Detection ─────────────────────────────────────────────────────────
+    strategy: str                         # concrete strategy tag (e.g. "GBPUSD_BB_BOUNCE_L")
+    strategy_family: str                  # one of FAMILY_* — coarse group
+    side: str                             # SIDE_LONG or SIDE_SHORT
+    opportunity_type: str                 # one of OPPORTUNITY_*
+
+    # ── Proposed order geometry ───────────────────────────────────────────
+    candidate_price: float                # mid price at detection
+    proposed_stop: Optional[float]        # None when detector defers to gate defaults
+    proposed_target: Optional[float]      # None when detector defers to gate defaults
+
+    # ── Provenance & context ──────────────────────────────────────────────
+    source_path: str                      # one of SOURCE_* — which dispatch site
+    day_type_raw: Dict[str, Any] = field(default_factory=dict)
+    """Raw day labels captured verbatim — keys typically include
+    'calendar_day_type', 'day_context', 'day_posture_subtype'. Canonical
+    mapping is a separate audit field (see day_type_adapter).
+    """
+
+    market_state_snapshot: Dict[str, Any] = field(default_factory=dict)
+    """Shallow dict of regime + structural + level state at detection.
+    Suggested keys: regime, regime_confidence, htf_bias, trend_subtype,
+    range_flag, chop_flag, structural_state, distance_to_nearest_level,
+    briefing_bias.
+    """
+
+    reason_codes: List[str] = field(default_factory=list)
+    """Machine-readable tags describing WHY the detector emitted this.
+    Additive across the pipeline: the gate appends its own codes when
+    it rejects or approves.
+    """
+
+    mechanical_valid: bool = True
+    """False when the detector's own mechanical prechecks failed (bad
+    price, missing snapshot). The gate still receives the candidate for
+    corpus completeness but always rejects it.
+    """
+
+    metadata: Dict[str, Any] = field(default_factory=dict)
+    """Free-form dict for strategy-specific extras. Included in the
+    corpus row. Consumers must not depend on any specific key.
+    """
+
+    event_id: Optional[str] = None
+    """News event id when the candidate is a news-family detection;
+    None otherwise.
+    """
+
+    # ── Detection lineage ─────────────────────────────────────────────────
+    # Populated by orchestrator_v2 when it accepts a raw detection.
+    first_detected_ts: Optional[str] = None
+    first_actionable_ts: Optional[str] = None
+
+    def __post_init__(self) -> None:
+        # These are hard invariants — a violation is a defect, not a
+        # runtime condition. Assertions would be silent under -O; raise
+        # ValueError so callers see the failure regardless.
+        if not self.candidate_id:
+            raise ValueError("Candidate.candidate_id is required")
+        if not self.timestamp:
+            raise ValueError("Candidate.timestamp is required")
+        if not self.epic:
+            raise ValueError("Candidate.epic is required")
+        if not self.pair:
+            raise ValueError("Candidate.pair is required")
+        if not self.strategy:
+            raise ValueError("Candidate.strategy is required")
+        if not self.strategy_family:
+            raise ValueError("Candidate.strategy_family is required")
+        if self.side not in _VALID_SIDES:
+            raise ValueError(
+                f"Candidate.side must be one of {sorted(_VALID_SIDES)}; "
+                f"got {self.side!r}"
+            )
+        if not self.opportunity_type:
+            raise ValueError("Candidate.opportunity_type is required")
+        if not isinstance(self.candidate_price, (int, float)):
+            raise ValueError("Candidate.candidate_price must be numeric")
+        if not self.source_path:
+            raise ValueError("Candidate.source_path is required")
+
+    # ── Helpers ───────────────────────────────────────────────────────────
+    def with_reason(self, *codes: str) -> "Candidate":
+        """Return a new Candidate with additional reason_codes appended.
+
+        Since Candidate is frozen, this is the safe way to enrich reasons
+        as the candidate flows through the orchestrator/gate.
+        """
+        return replace(self, reason_codes=list(self.reason_codes) + list(codes))
+
+    def with_actionable(self, actionable_ts: str) -> "Candidate":
+        """Stamp the FIRST_ACTIONABLE_TS lineage field."""
+        return replace(self, first_actionable_ts=actionable_ts)
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Serialise for corpus writing. All values are JSON-safe by
+        construction (no callables in metadata or snapshot)."""
+        return {
+            "candidate_id": self.candidate_id,
+            "timestamp": self.timestamp,
+            "epic": self.epic,
+            "pair": self.pair,
+            "strategy": self.strategy,
+            "strategy_family": self.strategy_family,
+            "side": self.side,
+            "opportunity_type": self.opportunity_type,
+            "candidate_price": self.candidate_price,
+            "proposed_stop": self.proposed_stop,
+            "proposed_target": self.proposed_target,
+            "source_path": self.source_path,
+            "day_type_raw": dict(self.day_type_raw),
+            "market_state_snapshot": dict(self.market_state_snapshot),
+            "reason_codes": list(self.reason_codes),
+            "mechanical_valid": self.mechanical_valid,
+            "metadata": dict(self.metadata),
+            "event_id": self.event_id,
+            "first_detected_ts": self.first_detected_ts,
+            "first_actionable_ts": self.first_actionable_ts,
+        }
+
+
+# ── Vocabulary helpers ─────────────────────────────────────────────────────
+_ALL_FAMILIES: Tuple[str, ...] = tuple(
+    v for k, v in globals().items() if k.startswith("FAMILY_") and isinstance(v, str)
+)
+_ALL_OPPORTUNITY_TYPES: Tuple[str, ...] = tuple(
+    v for k, v in globals().items() if k.startswith("OPPORTUNITY_") and isinstance(v, str)
+)
+_ALL_SOURCES: Tuple[str, ...] = tuple(
+    v for k, v in globals().items() if k.startswith("SOURCE_") and isinstance(v, str)
+)
+
+
+def is_known_family(name: str) -> bool:
+    return name in _ALL_FAMILIES
+
+
+def is_known_opportunity_type(name: str) -> bool:
+    return name in _ALL_OPPORTUNITY_TYPES
+
+
+def is_known_source(name: str) -> bool:
+    return name in _ALL_SOURCES
+
+
+def known_families() -> Tuple[str, ...]:
+    return tuple(sorted(_ALL_FAMILIES))
+
+
+def known_opportunity_types() -> Tuple[str, ...]:
+    return tuple(sorted(_ALL_OPPORTUNITY_TYPES))
+
+
+def known_sources() -> Tuple[str, ...]:
+    return tuple(sorted(_ALL_SOURCES))
