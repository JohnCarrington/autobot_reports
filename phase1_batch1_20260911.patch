@@ -0,0 +1,199 @@
+"""Phase 1 §4 StrategyOrchestrator tests."""
+from __future__ import annotations
+
+import os
+from datetime import datetime, timezone
+
+import pytest
+
+import candidate as _cand
+import central_execution_gate as _gate
+import orchestrator_v2 as _orch
+import candidate_corpus_writer as _corpus
+
+
+@pytest.fixture(autouse=True)
+def _reset(tmp_path, monkeypatch):
+    _gate._reset_for_tests()
+    _orch._reset_for_tests()
+    corpus_log = tmp_path / "candidate_corpus.jsonl"
+    _corpus._reset_for_tests(corpus_log)
+    monkeypatch.setenv("CANDIDATE_CORPUS_LOG_PATH", str(corpus_log))
+    monkeypatch.setenv("CANDIDATE_CORPUS_WRITER_ENABLED", "1")
+    monkeypatch.setenv("TRADE_ENABLED", "1")
+    monkeypatch.setenv("QM_ENTRY_HOURS_ENABLED", "0")
+    monkeypatch.setenv("ONE_BOOK_GUARD", "0")
+    yield
+    _gate._reset_for_tests()
+    _orch._reset_for_tests()
+
+
+def test_default_orchestrator_flag_is_shadow(monkeypatch):
+    monkeypatch.delenv("CENTRAL_STRATEGY_ORCHESTRATOR", raising=False)
+    assert _orch.orchestrator_active() is False
+
+
+def test_build_candidate_produces_valid_candidate():
+    c = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="GBPUSD_BB_BOUNCE_L",
+        strategy_family=_cand.FAMILY_BB_BOUNCE,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_BOUNCE,
+        candidate_price=13550.0,
+        source_path=_cand.SOURCE_5M_CLOSE_BB_BOUNCE,
+    )
+    assert c.candidate_id
+    assert c.first_detected_ts is not None
+
+
+def test_submit_writes_corpus_row(tmp_path, monkeypatch):
+    c = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="GBPUSD_BB_BOUNCE_L",
+        strategy_family=_cand.FAMILY_BB_BOUNCE,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_BOUNCE,
+        candidate_price=13550.0,
+        source_path=_cand.SOURCE_5M_CLOSE_BB_BOUNCE,
+    )
+    r = _orch.submit(c)
+    assert r.canonical_candidate.candidate_id == c.candidate_id
+    # Corpus file should exist and have a row
+    log_path = os.environ["CANDIDATE_CORPUS_LOG_PATH"]
+    assert os.path.exists(log_path)
+    with open(log_path) as fh:
+        rows = fh.readlines()
+    assert len(rows) == 1
+
+
+def test_tie_resolution_higher_precedence_wins():
+    # Two candidates in the same (epic, side, bucket). News-family wins
+    # over BB_BOUNCE.
+    bb = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="GBPUSD_BB_BOUNCE_L",
+        strategy_family=_cand.FAMILY_BB_BOUNCE,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_BOUNCE,
+        candidate_price=13550.0,
+        source_path=_cand.SOURCE_5M_CLOSE_BB_BOUNCE,
+        detected_ts="2026-09-11T09:00:00+00:00",
+    )
+    news = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="NEWS_FADE_L",
+        strategy_family=_cand.FAMILY_NEWS_STRATEGY,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_NEWS_FADE,
+        candidate_price=13550.5,
+        source_path=_cand.SOURCE_NEWS_STRATEGY,
+        detected_ts="2026-09-11T09:00:00+00:00",
+    )
+    r1 = _orch.submit(bb)
+    r2 = _orch.submit(news)
+    # The news candidate has higher family precedence, so bb should be
+    # marked tie_loser (via the retroactive resolution at second submit).
+    assert r2.tie_winner is True
+    assert r2.tie_loser is False
+    # The BB candidate submitted first — at its own submission it was
+    # solo, so tie_winner=True. Its follow-up dispositon is captured in
+    # the second submission's resolution: r2.tie_winner_id is set to
+    # news.candidate_id.
+    assert r2.tie_winner_id == news.candidate_id
+
+
+def test_tie_loser_gate_downgraded_to_disallow(monkeypatch):
+    """After tie loss, the loser's GateDecision.allowed must be False
+    with a reason 'orchestrator_tie_loss:...' merged in."""
+    monkeypatch.setenv("TRADE_ENABLED", "1")
+    a = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="A_LOW_PREC",
+        strategy_family=_cand.FAMILY_BB_BOUNCE,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_BOUNCE,
+        candidate_price=1.0,
+        source_path=_cand.SOURCE_5M_CLOSE_BB_BOUNCE,
+        detected_ts="2026-09-11T09:00:00+00:00",
+    )
+    b = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="B_HIGH_PREC",
+        strategy_family=_cand.FAMILY_NEWS_STRATEGY,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_NEWS_FADE,
+        candidate_price=1.0,
+        source_path=_cand.SOURCE_NEWS_STRATEGY,
+        detected_ts="2026-09-11T09:00:00+00:00",
+    )
+    _orch.submit(a)
+    r_b = _orch.submit(b)
+    # But now submit a THIRD lower-priority one in the same bucket — it
+    # should be marked tie_loser.
+    c_lower = _orch.build_candidate(
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="C_LOWEST_PREC",
+        strategy_family=_cand.FAMILY_EMA_PULLBACK,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_TREND_PULLBACK,
+        candidate_price=1.0,
+        source_path=_cand.SOURCE_5M_CLOSE_EMA_PULLBACK,
+        detected_ts="2026-09-11T09:00:00+00:00",
+    )
+    r_c = _orch.submit(c_lower)
+    assert r_c.tie_loser is True
+    assert r_c.gate_decision.allowed is False
+    assert any(
+        "orchestrator_tie_loss" in code
+        for code in r_c.gate_decision.reason_codes
+    )
+    # Reservation released:
+    assert r_c.gate_decision.reservation_id is None
+
+
+def test_orchestrator_never_raises_on_broken_candidate():
+    """A caller submitting a malformed object must not crash the
+    orchestrator. The important invariant is that submit() RETURNS
+    rather than propagating an exception; the gate verdict itself is
+    whatever the delegates decide."""
+    class Broken:
+        candidate_id = "b"
+    r = _orch.submit(Broken())
+    assert r is not None
+    assert r.canonical_candidate is not None
+    # Structural: return type is SubmitResult and gate_decision exists
+    assert hasattr(r, "gate_decision")
