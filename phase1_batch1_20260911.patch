+"""Phase 1 §10 outcome_grader tests."""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Sequence
+
+import pytest
+
+import outcome_grader as _grader
+
+
+def _mk_bars(sequence):
+    """Build 5m bars from [(o,h,l,c), ...]."""
+    return [
+        {"timestamp": f"2026-09-11T09:{i*5:02d}:00+00:00",
+         "open": o, "high": h, "low": l, "close": c}
+        for i, (o, h, l, c) in enumerate(sequence)
+    ]
+
+
+def test_grade_long_target_hit_first():
+    bars = _mk_bars([
+        (100.0, 105.0, 99.0, 104.0),   # +5p fav, -1p adv
+        (104.0, 112.0, 103.0, 111.0),  # target at +10p hit
+    ])
+    def fetch(_pair, _ts, _n): return bars
+    g = _grader.grade(
+        anchor_ts="2026-09-11T09:00:00+00:00", side="LONG",
+        entry_price=100.0, pair="GBPUSD",
+        proposed_stop=95.0, proposed_target=110.0,
+        get_bars_after=fetch, horizon_bars=50,
+    )
+    assert g.target_first is True
+    assert g.stop_first is False
+    assert g.mfe_pips >= 10.0
+    assert g.mae_pips >= 1.0
+
+
+def test_grade_short_stop_hit_first():
+    bars = _mk_bars([
+        (100.0, 108.0, 99.5, 107.0),  # SHORT: adverse to +8p high
+    ])
+    def fetch(*_a, **_kw): return bars
+    g = _grader.grade(
+        anchor_ts="2026-09-11T09:00:00+00:00", side="SHORT",
+        entry_price=100.0, pair="GBPUSD",
+        proposed_stop=105.0, proposed_target=90.0,
+        get_bars_after=fetch, horizon_bars=50,
+    )
+    assert g.stop_first is True
+    assert g.target_first is False
+
+
+def test_grade_no_bars_notes():
+    g = _grader.grade(
+        anchor_ts="x", side="LONG", entry_price=1.0, pair="GBPUSD",
+        proposed_stop=None, proposed_target=None,
+        get_bars_after=lambda *_a, **_kw: [],
+    )
+    assert g.notes == ["no_bars"]
+    assert g.mfe_pips is None
+
+
+def test_grade_never_raises_on_fetch_failure():
+    def bad(*_a, **_kw): raise RuntimeError("boom")
+    g = _grader.grade(
+        anchor_ts="x", side="LONG", entry_price=1.0, pair="GBPUSD",
+        proposed_stop=None, proposed_target=None, get_bars_after=bad,
+    )
+    assert any("get_bars_failed" in n for n in g.notes)
+
+
+def test_grade_qm_candidate_row_populates_outcome():
+    """QM candidates today have empty outcome dicts (Phase 0 finding).
+    The shadow populator fills them without enabling QM live fire."""
+    bars = _mk_bars([(100.0, 105.0, 99.0, 104.0)])
+    row = {
+        "symbol": "GBPUSD",
+        "opened_at": "2026-09-11T09:00:00+00:00",
+        "hypothetical_entry": 100.0,
+        "hypothetical_stop": 95.0,
+        "hypothetical_target": 110.0,
+        "outcome": {},
+    }
+    out = _grader.grade_qm_candidate_row(row, get_bars_after=lambda *_a, **_kw: bars)
+    assert "outcome" in out
+    assert out["outcome_prior"] == {}
+    # Direction inferred from stop < entry → LONG
+    assert out["outcome"]["mfe_pips"] >= 5.0
