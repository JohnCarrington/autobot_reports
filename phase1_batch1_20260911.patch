+Ensures the SHIPPED default state of the Phase 1 modules keeps
+production behaviour unchanged. This test does NOT read /opt/tradingbot/.env
+(that is the operator's live config); it verifies that when the flags
+are UNSET, the module defaults resolve to inert/shadow behaviour.
+"""
+from __future__ import annotations
+
+import pytest
+
+
+def test_central_execution_gate_default_off(monkeypatch):
