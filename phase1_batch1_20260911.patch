@@ -0,0 +1,133 @@
+"""Phase 1 §18/§20 broker-open bypass test.
+
+Enforces that every PRODUCTION callsite that can reach the broker
+opening primitive (open_sb_now.open_sb_now, which calls
+IGService.create_open_position) is on the maintained allowlist.
+
+The allowlist lives in tests/unit/broker_open_allowlist.json — a
+machine-readable manifest of file:line:function tuples that are
+KNOWN AND APPROVED to reach the broker.
+
+Failing this test means either:
+    a) A new production callsite was added that reaches the broker
+       without going through CentralExecutionGate — remove it or
+       route it through the gate, then update the allowlist; OR
+    b) An existing callsite moved (line number changed) — verify it
+       still routes through the gate and refresh the allowlist entry.
+
+This test is DESIGNED to fail loudly. Do not comment it out; if the
+change is intentional, refresh the allowlist and re-run.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+
+import pytest
+
+
+ROOT = Path("/opt/tradingbot")
+ALLOWLIST_PATH = Path(__file__).parent / "broker_open_allowlist.json"
+
+# Production-file filter — exclude scratch, tests, replay, backtests.
+_EXCLUDE_PREFIXES = ("_", "test_", "backtest_", "true_replay", "replay_", "_monday_")
+_EXCLUDE_DIRS = {"tests", "__pycache__", "scripts", "backups", "reports", "reports-public",
+                 "logs", "cache", "data", "briefings", "diagnostics", ".git", ".venv",
+                 "venv", "env", "env-history", "config", "deploy", "docs",
+                 "rest_experiments", "ui_experiments", "tests_quarantine", "backtest_results",
+                 ".claude", "briefing"}
+
+
+def _iter_production_py_files():
+    for path in sorted(ROOT.rglob("*.py")):
+        rel = path.relative_to(ROOT)
+        parts = rel.parts
+        if any(p in _EXCLUDE_DIRS for p in parts):
+            continue
+        name = parts[-1]
+        if any(name.startswith(p) for p in _EXCLUDE_PREFIXES):
+            continue
+        yield path
+
+
+def _scan_for_broker_open_callers():
+    """Return list of {file, line, snippet} for every direct or aliased
+    call to open_sb_now / create_open_position in production files."""
+    patterns = [
+        re.compile(r"\bopen_sb_now\s*\("),
+        re.compile(r"\.create_open_position\s*\("),
+    ]
+    hits = []
+    for path in _iter_production_py_files():
+        try:
+            with path.open("r", encoding="utf-8") as fh:
+                for i, line in enumerate(fh, 1):
+                    if any(p.search(line) for p in patterns):
+                        stripped = line.strip()
+                        # Skip non-call occurrences.
+                        if stripped.startswith(("from ", "import ", "#")):
+                            continue
+                        if stripped.startswith("def ") or stripped.startswith("async def "):
+                            continue
+                        if '"""' in stripped or "'''" in stripped:
+                            continue
+                        if stripped.startswith(("print(", "logger.", "raise ")):
+                            continue
+                        # Skip test-hook injections (osb.open_sb_now = ...) — not calls.
+                        if re.search(r"\bopen_sb_now\s*=", stripped):
+                            continue
+                        hits.append({
+                            "file": str(path.relative_to(ROOT)),
+                            "line": i,
+                            "snippet": stripped[:120],
+                        })
+        except Exception:
+            continue
+    return hits
+
+
+def test_broker_open_allowlist_exists():
+    assert ALLOWLIST_PATH.exists(), (
+        f"Broker-open allowlist not found at {ALLOWLIST_PATH}. "
+        f"Refresh it via the caller audit — Phase 1 §18/§20."
+    )
+
+
+def test_every_broker_open_caller_is_allowlisted():
+    with ALLOWLIST_PATH.open() as fh:
+        allow = json.load(fh)
+    allowed = {(e["file"], e["line"]) for e in allow.get("entries", [])}
+    hits = _scan_for_broker_open_callers()
+    unlisted = [h for h in hits if (h["file"], h["line"]) not in allowed]
+    if unlisted:
+        rendered = "\n".join(
+            f"  {h['file']}:{h['line']}  {h['snippet']}" for h in unlisted
+        )
+        pytest.fail(
+            "New / moved broker-open callers detected that are NOT on the "
+            "allowlist. Every production line that reaches the broker "
+            "must route through CentralExecutionGate (Phase 1 §18).\n\n"
+            f"Unlisted callers:\n{rendered}\n\n"
+            f"Refresh the allowlist at {ALLOWLIST_PATH} after verifying "
+            "the caller is legitimate + routed."
+        )
+
+
+def test_no_allowlist_entry_is_stale():
+    """Every allowlisted entry must still match a real callsite. Removing
+    a caller must also remove the allowlist entry."""
+    with ALLOWLIST_PATH.open() as fh:
+        allow = json.load(fh)
+    hits = {(h["file"], h["line"]) for h in _scan_for_broker_open_callers()}
+    stale = [
+        e for e in allow.get("entries", [])
+        if (e["file"], e["line"]) not in hits
+    ]
+    if stale:
+        pytest.fail(
+            "Allowlist has stale entries no longer present in the code:\n"
+            + "\n".join(f"  {e['file']}:{e['line']}  ({e.get('reason','?')})"
+                       for e in stale)
+        )
