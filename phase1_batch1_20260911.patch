+"""outcome_grader.py — Phase 1 candidate outcome grading foundation.
+
+Per Phase 1 §10.
+
+Purpose: given a Candidate row from the corpus (or a QM candidate row
+from logs/qm_candidates.jsonl) and the subsequent OHLC, produce a
+structured outcome dict. Phase 1 does NOT train any model; it only
+builds the grading schema + a shadow populator so QM candidates and
+new corpus candidates start accumulating outcomes.
+
+**Explicitly out of scope (spec §22)**:
+    * Any live gating from grader output.
+    * Any ML training.
+    * QM live fire — QM_LIVE_FIRE remains OFF.
+
+Outcome schema (populated over future bars from an anchor timestamp
+and side/price):
+    mfe_pips              float   max favourable excursion
+    mae_pips              float   max adverse excursion
+    time_to_mfe_min       int     minutes from anchor to MFE bar
+    time_to_mae_min       int     minutes from anchor to MAE bar
+    excursion_20bar_pips  float   MFE over first 20 5m bars (spec §118G)
+    drawdown_20bar_pips   float   MAE over first 20 5m bars
+    target_first          bool | null   True iff proposed_target hit before proposed_stop
+    stop_first            bool | null   True iff proposed_stop hit before target
+    horizon_bars_evaluated int
+    graded_at_ts          str
+    grader_version        str
+    notes                 List[str]
+
+Grader deliberately does NOT compute counterfactual entry alternatives
+here (that's the self-learning entry module). This grader answers "what
+did the market DO after the candidate ARMed" — not "what fill was
+achievable".
+
+Data source: 5m OHLC via a supplied callable. In production wire this
+to candle_builder.get_df; in tests/replay wire it to a fixture. The
+grader is source-agnostic.
+"""
+from __future__ import annotations
+
+import logging
+import os
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any, Callable, Dict, List, Optional, Sequence
+
+logger = logging.getLogger(__name__)
+
+GRADER_VERSION = "phase1.0"
+
+
+@dataclass
+class OutcomeGrade:
+    mfe_pips: Optional[float] = None
+    mae_pips: Optional[float] = None
+    time_to_mfe_min: Optional[int] = None
+    time_to_mae_min: Optional[int] = None
+    excursion_20bar_pips: Optional[float] = None
+    drawdown_20bar_pips: Optional[float] = None
+    target_first: Optional[bool] = None
+    stop_first: Optional[bool] = None
+    horizon_bars_evaluated: int = 0
+    graded_at_ts: str = ""
+    grader_version: str = GRADER_VERSION
+    notes: List[str] = field(default_factory=list)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "mfe_pips": self.mfe_pips,
+            "mae_pips": self.mae_pips,
+            "time_to_mfe_min": self.time_to_mfe_min,
+            "time_to_mae_min": self.time_to_mae_min,
+            "excursion_20bar_pips": self.excursion_20bar_pips,
+            "drawdown_20bar_pips": self.drawdown_20bar_pips,
+            "target_first": self.target_first,
+            "stop_first": self.stop_first,
+            "horizon_bars_evaluated": self.horizon_bars_evaluated,
+            "graded_at_ts": self.graded_at_ts,
+            "grader_version": self.grader_version,
+            "notes": list(self.notes),
+        }
+
+
+def _pip_size(pair: str) -> float:
+    """Pip-size in price units. Matches production convention: FX pairs
+    priced in points (e.g. GBPUSD 13530.88 → pip=1.0). JPY pairs also
+    use 1.0 in this codebase (see regime_router_engine.py _PIP_SIZE).
+    """
+    p = str(pair or "").upper()
+    return 1.0 if p else 1.0
+
+
+def grade(
+    *,
+    anchor_ts: str,
+    side: str,
+    entry_price: float,
+    pair: str,
+    proposed_stop: Optional[float],
+    proposed_target: Optional[float],
+    get_bars_after: Callable[[str, str, int], Sequence[Dict[str, Any]]],
+    horizon_bars: int = 240,
+    excursion_window_bars: int = 20,
+) -> OutcomeGrade:
+    """Grade an anchor-point candidate against subsequent bars.
+
+    Args:
+        anchor_ts: ISO-8601 UTC of the FIRST_ACTIONABLE_TS (or
+                   execution_ts if we're grading the actual fire).
+        side: "LONG"/"SHORT" or "BUY"/"SELL".
+        entry_price: price at anchor.
+        pair: e.g. "GBPUSD".
+        proposed_stop: optional; when present target_first/stop_first
+                       are populated.
+        proposed_target: optional; ditto.
+        get_bars_after: callable(pair, iso_ts, n_bars) -> list of dicts
+                       with keys 'timestamp', 'open', 'high', 'low',
+                       'close'. Ordered chronologically. Returns []
+                       when unavailable.
+        horizon_bars: max lookahead in 5m bars.
+        excursion_window_bars: window for the 20-bar excursion labels.
+
+    Never raises. On failure returns an OutcomeGrade with notes filled.
+    """
+    g = OutcomeGrade(graded_at_ts=datetime.now(timezone.utc).isoformat())
+    try:
+        bars = list(get_bars_after(pair, anchor_ts, horizon_bars) or [])
+    except Exception as exc:
+        g.notes.append(f"get_bars_failed:{type(exc).__name__}")
+        return g
+
+    if not bars:
+        g.notes.append("no_bars")
+        return g
+
+    pip = _pip_size(pair)
+    is_long = str(side).upper() in ("LONG", "BUY")
+
+    mfe = 0.0
+    mae = 0.0
+    t_mfe = 0
+    t_mae = 0
+    excursion_20 = 0.0
+    drawdown_20 = 0.0
+    hit_target: Optional[bool] = None
+    hit_stop: Optional[bool] = None
+
+    for i, bar in enumerate(bars[: horizon_bars]):
+        try:
+            hi = float(bar.get("high"))
+            lo = float(bar.get("low"))
+        except Exception:
+            continue
+        # Favourable/adverse in pips
+        if is_long:
+            fav = (hi - entry_price) / pip
+            adv = (entry_price - lo) / pip
+        else:
+            fav = (entry_price - lo) / pip
+            adv = (hi - entry_price) / pip
+        if fav > mfe:
+            mfe = fav
+            t_mfe = (i + 1) * 5  # 5-min bars → minutes to bar-end
+        if adv > mae:
+            mae = adv
+            t_mae = (i + 1) * 5
+
+        # 20-bar excursion window (spec §118G fixed horizon)
+        if i < excursion_window_bars:
+            if fav > excursion_20:
+                excursion_20 = fav
+            if adv > drawdown_20:
+                drawdown_20 = adv
+
+        # Target/stop first-touch — checked only when both provided.
+        if (
+            proposed_stop is not None and proposed_target is not None
+            and hit_target is None and hit_stop is None
+        ):
+            if is_long:
+                # LONG: target above entry, stop below.
+                if hi >= proposed_target:
+                    hit_target = True
+                    hit_stop = False
+                    break
+                if lo <= proposed_stop:
+                    hit_stop = True
+                    hit_target = False
+                    break
+            else:
+                if lo <= proposed_target:
+                    hit_target = True
+                    hit_stop = False
+                    break
+                if hi >= proposed_stop:
+                    hit_stop = True
+                    hit_target = False
+                    break
+
+    g.mfe_pips = round(mfe, 2)
+    g.mae_pips = round(mae, 2)
+    g.time_to_mfe_min = t_mfe or None
+    g.time_to_mae_min = t_mae or None
+    g.excursion_20bar_pips = round(excursion_20, 2)
+    g.drawdown_20bar_pips = round(drawdown_20, 2)
+    g.target_first = hit_target
+    g.stop_first = hit_stop
+    g.horizon_bars_evaluated = min(len(bars), horizon_bars)
+    return g
+
+
+# ── Shadow population for QM candidates ────────────────────────────────────
+# Phase 0 found 670 QM candidate rows with empty outcome dicts. QM live
+# fire remains OFF (§22). This helper grades a QM candidate row using
+# its hypothetical_entry / hypothetical_stop / hypothetical_target as
+# the anchor — pure observation, never a fire.
+
+def grade_qm_candidate_row(
+    row: Dict[str, Any],
+    *,
+    get_bars_after: Callable[[str, str, int], Sequence[Dict[str, Any]]],
+) -> Dict[str, Any]:
+    """Grade one QM candidate row (from logs/qm_candidates.jsonl).
+
+    Returns the row with a new "outcome" key populated. The original
+    outcome dict (empty in production today) is preserved under
+    "outcome_prior" for auditability.
+
+    Never raises.
+    """
+    out = dict(row)
+    try:
+        anchor = row.get("opened_at") or ""
+        side_hint = str((row.get("m5_signals") or [None])[0] or "").upper()
+        # QM stores hypothetical_entry as a number; infer side from
+        # entry vs stop when available.
+        entry = row.get("hypothetical_entry")
+        stop = row.get("hypothetical_stop")
+        target = row.get("hypothetical_target")
+        pair = str(row.get("symbol") or "").upper()
+
+        if entry is None or pair == "":
+            out["outcome_prior"] = row.get("outcome") or {}
+            out["outcome"] = {"notes": ["insufficient_inputs"]}
+            return out
+
+        side = "LONG"
+        if isinstance(stop, (int, float)) and isinstance(entry, (int, float)):
+            side = "LONG" if stop < entry else "SHORT"
+        elif side_hint in ("BUY", "LONG"):
+            side = "LONG"
+        elif side_hint in ("SELL", "SHORT"):
+            side = "SHORT"
+
+        g = grade(
+            anchor_ts=str(anchor),
+            side=side,
+            entry_price=float(entry),
+            pair=pair,
+            proposed_stop=float(stop) if isinstance(stop, (int, float)) else None,
+            proposed_target=float(target) if isinstance(target, (int, float)) else None,
+            get_bars_after=get_bars_after,
+        )
+        out["outcome_prior"] = row.get("outcome") or {}
+        out["outcome"] = g.to_dict()
+    except Exception as exc:
+        out["outcome_prior"] = row.get("outcome") or {}
+        out["outcome"] = {"notes": [f"grader_exception:{type(exc).__name__}"]}
+    return out
