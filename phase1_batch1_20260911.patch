+"""Phase 1 §3 Candidate contract tests."""
+from __future__ import annotations
+
+import pytest
+
+import candidate as _cand
+
+
+def _make_min_candidate(**overrides):
+    kw = dict(
+        candidate_id="c-1",
+        timestamp="2026-09-11T09:00:00+00:00",
+        epic="CS.D.GBPUSD.TODAY.IP",
+        pair="GBPUSD",
+        strategy="GBPUSD_BB_BOUNCE_L",
+        strategy_family=_cand.FAMILY_BB_BOUNCE,
+        side=_cand.SIDE_LONG,
+        opportunity_type=_cand.OPPORTUNITY_BOUNCE,
+        candidate_price=13550.0,
+        proposed_stop=13530.0,
+        proposed_target=13650.0,
+        source_path=_cand.SOURCE_5M_CLOSE_BB_BOUNCE,
+    )
+    kw.update(overrides)
+    return _cand.Candidate(**kw)
+
+
+def test_candidate_requires_all_mandatory_fields():
+    with pytest.raises(TypeError):
+        _cand.Candidate()  # type: ignore[call-arg]
+
+
+def test_candidate_rejects_blank_id():
+    with pytest.raises(ValueError):
+        _make_min_candidate(candidate_id="")
+
+
+def test_candidate_rejects_invalid_side():
+    with pytest.raises(ValueError):
+        _make_min_candidate(side="MAYBE")
+
+
+def test_candidate_is_frozen():
+    c = _make_min_candidate()
+    with pytest.raises(Exception):
+        c.candidate_price = 99.0  # type: ignore[misc]
+
+
+def test_candidate_to_dict_is_json_safe():
+    import json
+    c = _make_min_candidate(metadata={"note": "hi", "n": 3})
+    d = c.to_dict()
+    assert isinstance(d, dict)
+    json.dumps(d)  # must not raise
+
+
+def test_with_reason_appends_and_returns_new_instance():
+    c = _make_min_candidate(reason_codes=["initial"])
+    c2 = c.with_reason("extra", "and_more")
+    assert c is not c2
+    assert c.reason_codes == ["initial"]  # original unchanged
+    assert c2.reason_codes == ["initial", "extra", "and_more"]
+
+
+def test_known_vocabulary_helpers():
+    assert _cand.is_known_family(_cand.FAMILY_BB_BOUNCE)
+    assert not _cand.is_known_family("BOGUS_FAMILY")
+    assert _cand.is_known_opportunity_type(_cand.OPPORTUNITY_BOUNCE)
+    assert _cand.is_known_source(_cand.SOURCE_5M_CLOSE_BB_BOUNCE)
+
+
+def test_candidate_cannot_execute_or_side_effect():
+    """A Candidate object must expose no method capable of placing an
+    order or amending a stop. Enforced by inspection — attribute names
+    that would suggest execution capability must be absent."""
+    c = _make_min_candidate()
+    forbidden = (
+        "execute", "fire", "submit", "open_position", "close_position",
+        "amend_stop", "amend_broker_sl", "place_order",
+    )
+    for name in forbidden:
+        assert not hasattr(c, name), (
+            f"Candidate must not expose {name!r} — it says 'I detect', "
+            f"not 'I trade'"
+        )
