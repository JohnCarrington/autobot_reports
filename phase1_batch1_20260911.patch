+++ b/candidate_corpus_writer.py
@@ -0,0 +1,177 @@
+"""candidate_corpus_writer.py — Phase 1 candidate + gate-decision log.
+
+Per Phase 1 §9. Writes every Candidate the orchestrator sees, regardless
+of gate outcome, to a single append-only JSONL. This is the corpus the
+Phase 0 audit found to be MISSING (rejected-candidate coverage).
+
+Schema (one row per (candidate, gate_decision) pair):
+    ts                 — ISO-8601 UTC write time
+    candidate_id       — from Candidate
+    timestamp          — from Candidate (detection time)
+    epic
+    pair
+    strategy
+    strategy_family
+    side
+    opportunity_type
+    candidate_price
+    proposed_stop
+    proposed_target
+    source_path
+    day_type_raw       — raw calendar/day_context labels
+    day_type_canonical — from day_type_adapter (may be UNKNOWN)
+    market_state_snapshot
+    reason_codes       — union of detector + gate reasons
+    mechanical_valid
+    metadata
+    event_id
+    first_detected_ts
+    first_actionable_ts
+    gate_allowed       — bool | null (null when gate did not evaluate)
+    gate_reason_codes  — list
+    gate_reservation_id — str | null
+    gate_capacity_snapshot — dict | null
+    executed           — bool
+    execution_deal_ref — str | null (from broker ack)
+    execution_deal_id  — str | null
+    execution_ts       — str | null
+    execution_price    — float | null
+
+Never raises. Log write failures degrade to logger.debug so a full disk
+cannot take down the trading loop.
+
+The writer is thread-safe via an in-module RLock.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import threading
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+_LOG_PATH = Path(os.getenv(
+    "CANDIDATE_CORPUS_LOG_PATH",
+    "/opt/tradingbot/logs/candidate_corpus.jsonl",
+))
+_ENABLED = str(os.getenv("CANDIDATE_CORPUS_WRITER_ENABLED", "1")).strip().lower() in (
+    "1", "true", "yes", "on",
+)
+
+_LOCK = threading.RLock()
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _safe(v: Any) -> Any:
+    """Best-effort JSON-safe coercion. Never raises."""
+    try:
+        json.dumps(v)
+        return v
+    except Exception:
+        try:
+            return str(v)
+        except Exception:
+            return None
+
+
+def _write(row: Dict[str, Any]) -> None:
+    if not _ENABLED:
+        return
+    try:
+        with _LOCK:
+            _LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
+            with _LOG_PATH.open("a", encoding="utf-8") as fh:
+                fh.write(json.dumps(row, sort_keys=True, default=str) + "\n")
+    except Exception as exc:
+        logger.debug("[candidate_corpus] write failed: %s", exc)
+
+
+def log_candidate(
+    candidate: Any,
+    *,
+    day_type_canonical: Optional[str] = None,
+    gate_decision: Optional[Any] = None,
+    executed: bool = False,
+    execution_deal_ref: Optional[str] = None,
+    execution_deal_id: Optional[str] = None,
+    execution_ts: Optional[str] = None,
+    execution_price: Optional[float] = None,
+) -> None:
+    """Write one corpus row for `candidate` + optional gate decision.
+
+    Args:
+        candidate: Any object with a .to_dict() returning the Candidate
+                   schema (or a plain dict of that shape).
+        day_type_canonical: from day_type_adapter.resolve()["canonical"].
+        gate_decision: Optional GateDecision — None when the candidate
+                       never reached the gate (e.g. detector-side
+                       mechanical reject).
+        executed / execution_*: post-execution attributes. Passed None
+                       when the gate rejected or when execution failed.
+
+    Never raises.
+    """
+    try:
+        if hasattr(candidate, "to_dict"):
+            cand_row = candidate.to_dict()
+        elif isinstance(candidate, dict):
+            cand_row = dict(candidate)
+        else:
+            cand_row = {"repr": _safe(repr(candidate))}
+    except Exception as exc:
+        logger.debug("[candidate_corpus] to_dict failed: %s", exc)
+        cand_row = {"repr": _safe(repr(candidate))}
+
+    # Merge gate decision fields (if any).
+    gate_allowed: Optional[bool] = None
+    gate_codes: list = []
+    reservation_id: Optional[str] = None
+    capacity_snapshot: Optional[Dict[str, Any]] = None
+    if gate_decision is not None:
+        try:
+            gate_allowed = bool(getattr(gate_decision, "allowed"))
+            gate_codes = list(getattr(gate_decision, "reason_codes", []) or [])
+            reservation_id = getattr(gate_decision, "reservation_id", None)
+            capacity_snapshot = getattr(gate_decision, "capacity_snapshot", None)
+        except Exception as exc:
+            logger.debug("[candidate_corpus] gate_decision unpack failed: %s", exc)
+
+    # Union of detector + gate reason codes for easy grepping.
+    union_codes = list(cand_row.get("reason_codes") or []) + list(gate_codes)
+
+    row = {
+        "ts": _now_iso(),
+        **cand_row,
+        "reason_codes": union_codes,
+        "day_type_canonical": day_type_canonical,
+        "gate_allowed": gate_allowed,
+        "gate_reason_codes": gate_codes,
+        "gate_reservation_id": reservation_id,
+        "gate_capacity_snapshot": capacity_snapshot,
+        "executed": bool(executed),
+        "execution_deal_ref": execution_deal_ref,
+        "execution_deal_id": execution_deal_id,
+        "execution_ts": execution_ts,
+        "execution_price": execution_price,
+    }
+    _write(row)
+
+
+# Test hook — not for production use.
+def _reset_for_tests(path: Optional[Path] = None) -> None:
+    """Override log path (tests) and clear the file."""
+    global _LOG_PATH
+    if path is not None:
+        _LOG_PATH = Path(path)
+    try:
+        if _LOG_PATH.exists():
+            _LOG_PATH.unlink()
+    except Exception:
+        pass
