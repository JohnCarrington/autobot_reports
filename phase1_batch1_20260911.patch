+++ b/entry_instrumentation.py
@@ -0,0 +1,154 @@
+"""entry_instrumentation.py — Phase 1 self-learning entry data capture.
+
+Per Phase 1 §11.
+
+CAPTURES ONLY. Does not train, does not gate, does not counterfactual
+back-fill (§11 forbids hindsight leakage in Phase 1).
+
+For each fire attempt (candidate that reaches the gate + execution
+call), emit one row to logs/entry_instrumentation.jsonl:
+
+    candidate_id
+    strategy
+    strategy_family
+    pair
+    epic
+    side
+    FIRST_DETECTED_TS         — from Candidate.first_detected_ts
+    FIRST_ACTIONABLE_TS       — from Candidate.first_actionable_ts
+    CANDIDATE_PRICE           — from Candidate.candidate_price
+    EXECUTION_TS              — set when broker returned success
+    EXECUTION_PRICE           — mid or fill price at execution
+    ENTRY_DELAY_SECONDS       — EXECUTION_TS - FIRST_DETECTED_TS
+    ENTRY_DELAY_BARS          — floor(ENTRY_DELAY_SECONDS / 300)
+    PIPS_MOVED_BEFORE_ENTRY   — (EXECUTION_PRICE - CANDIDATE_PRICE) in
+                                pips, direction-signed (positive means
+                                the trade got a WORSE fill vs detection)
+    strategy_confirmation_state — dict, strategy-specific
+    level_context             — dict (nearest major level, distance, ...)
+    trend_context             — dict (regime, subtype, htf_bias)
+
+Outcome fields (AVAILABLE_RUN_PIPS, MFE_PIPS, MAE_PIPS,
+CAPTURED_RUN_PIPS, ..., MISSED_RUN_PIPS) are populated by a later
+grader pass — this module emits the entry-time slice only.
+
+Never raises. Log write failures degrade to logger.debug.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import threading
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+_LOG_PATH = Path(os.getenv(
+    "ENTRY_INSTRUMENTATION_LOG_PATH",
+    "/opt/tradingbot/logs/entry_instrumentation.jsonl",
+))
+_ENABLED = str(os.getenv("ENTRY_INSTRUMENTATION_ENABLED", "1")).strip().lower() in (
+    "1", "true", "yes", "on",
+)
+
+_LOCK = threading.RLock()
+
+
+def _write(row: Dict[str, Any]) -> None:
+    if not _ENABLED:
+        return
+    try:
+        with _LOCK:
+            _LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
+            with _LOG_PATH.open("a", encoding="utf-8") as fh:
+                fh.write(json.dumps(row, sort_keys=True, default=str) + "\n")
+    except Exception as exc:
+        logger.debug("[entry_instrumentation] write failed: %s", exc)
+
+
+def _pip_size(pair: str) -> float:
+    return 1.0  # FX + JPY convention in this codebase — see outcome_grader._pip_size
+
+
+def _iso_to_epoch(iso: Optional[str]) -> Optional[float]:
+    if not iso:
+        return None
+    try:
+        return datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp()
+    except Exception:
+        return None
+
+
+def record_fire_attempt(
+    *,
+    candidate: Any,
+    execution_ts: Optional[str] = None,
+    execution_price: Optional[float] = None,
+    strategy_confirmation_state: Optional[Dict[str, Any]] = None,
+    level_context: Optional[Dict[str, Any]] = None,
+    trend_context: Optional[Dict[str, Any]] = None,
+    fired: bool = False,
+    reason: Optional[str] = None,
+) -> None:
+    """Emit one instrumentation row for a candidate that reached the
+    gate. Called from either shadow orchestrator flow or the legacy
+    dispatch when it wants to piggy-back instrumentation. Never raises.
+    """
+    try:
+        cid = getattr(candidate, "candidate_id", None)
+        side = str(getattr(candidate, "side", "") or "").upper()
+        pair = str(getattr(candidate, "pair", "") or "").upper()
+        cand_price = getattr(candidate, "candidate_price", None)
+        first_detected = getattr(candidate, "first_detected_ts", None) \
+            or getattr(candidate, "timestamp", None)
+        first_actionable = getattr(candidate, "first_actionable_ts", None)
+
+        delay_seconds: Optional[float] = None
+        delay_bars: Optional[int] = None
+        pips_moved: Optional[float] = None
+
+        exec_epoch = _iso_to_epoch(execution_ts)
+        det_epoch = _iso_to_epoch(first_detected)
+        if exec_epoch is not None and det_epoch is not None:
+            delay_seconds = max(0.0, exec_epoch - det_epoch)
+            delay_bars = int(delay_seconds // 300)
+
+        if (
+            execution_price is not None
+            and isinstance(cand_price, (int, float))
+        ):
+            pip = _pip_size(pair)
+            # Positive pips_moved = worse fill for the trade direction.
+            if side in ("LONG", "BUY"):
+                pips_moved = (float(execution_price) - float(cand_price)) / pip
+            else:
+                pips_moved = (float(cand_price) - float(execution_price)) / pip
+
+        row = {
+            "ts": datetime.now(timezone.utc).isoformat(),
+            "candidate_id": cid,
+            "strategy": getattr(candidate, "strategy", None),
+            "strategy_family": getattr(candidate, "strategy_family", None),
+            "pair": pair,
+            "epic": getattr(candidate, "epic", None),
+            "side": side,
+            "FIRST_DETECTED_TS": first_detected,
+            "FIRST_ACTIONABLE_TS": first_actionable,
+            "CANDIDATE_PRICE": cand_price,
+            "EXECUTION_TS": execution_ts,
+            "EXECUTION_PRICE": execution_price,
+            "ENTRY_DELAY_SECONDS": delay_seconds,
+            "ENTRY_DELAY_BARS": delay_bars,
+            "PIPS_MOVED_BEFORE_ENTRY": pips_moved,
+            "strategy_confirmation_state": dict(strategy_confirmation_state or {}),
+            "level_context": dict(level_context or {}),
+            "trend_context": dict(trend_context or {}),
+            "fired": bool(fired),
+            "reason": reason,
+        }
+        _write(row)
+    except Exception as exc:
+        logger.debug("[entry_instrumentation] record raised: %s", exc)
