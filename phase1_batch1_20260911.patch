@@ -0,0 +1,225 @@
+#!/usr/bin/env python3
+"""phase1_parity_harness.py — Phase 1 §19 replay parity scaffold.
+
+Purpose: given a date range, compare EVERY attempted fire in the
+signal_log against what the shadow orchestrator/gate would have
+decided, and emit a machine-readable diff.
+
+**Batch 1 scaffold only.** This script wires the harness structure and
+performs a HISTORICAL-log comparison for fires already recorded in
+signal_log. It does NOT replay ticks through the live strategy code —
+that fuller replay (which reconstructs the OLD-would-attempt column
+for un-fired candidates) is Batch 2 once detector migration wraps.
+
+Output: JSONL to reports-public/phase1_parity_<from>_<to>.jsonl
++ a markdown summary report.
+
+Comparison columns (one row per attempt):
+    ts, epic, pair, strategy, side
+    old_attempted        : True (every signal_log row is an attempt)
+    old_reason           : reason at fire time / close_reason
+    old_executed         : True iff row has total_pnl_pips (i.e. broker fill)
+    new_orchestrator_received : False for Batch 1 (orchestrator not wired
+                            to legacy paths yet; expected — flagged so
+                            Batch 2 makes this True after migration)
+    new_gate_decision    : None (harness cannot fabricate a decision
+                            without the raw candidate snapshot)
+    new_result           : DEFERRED_TO_BATCH_2
+    match                : "deferred" (until Batch 2 wires migration)
+    explanation          : per-row narrative
+
+Use:
+    python3 scripts/phase1_parity_harness.py --from 2026-09-08 --to 2026-09-11
+    python3 scripts/phase1_parity_harness.py --list-attempts --from 2026-09-08 --to 2026-09-11
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Iterator, List, Optional
+
+
+ROOT = Path("/opt/tradingbot")
+SIGNAL_LOG_LIVE = ROOT / "logs" / "signal_log.jsonl"
+SIGNAL_LOG_ROTATED = ROOT / "logs" / "signal_log.jsonl-20260904"
+CANDIDATE_CORPUS = ROOT / "logs" / "candidate_corpus.jsonl"
+QM_CANDIDATES = ROOT / "logs" / "qm_candidates.jsonl"
+
+
+def _iter_signal_log(paths: List[Path]) -> Iterator[Dict[str, Any]]:
+    for p in paths:
+        if not p.exists():
+            continue
+        with p.open("r", encoding="utf-8") as fh:
+            for line in fh:
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    yield json.loads(line)
+                except Exception:
+                    continue
+
+
+def _in_range(ts: str, dt_from: datetime, dt_to: datetime) -> bool:
+    if not ts:
+        return False
+    try:
+        t = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
+    except Exception:
+        return False
+    if t.tzinfo is None:
+        t = t.replace(tzinfo=timezone.utc)
+    return dt_from <= t < dt_to
+
+
+def _load_signal_log_attempts(dt_from: datetime, dt_to: datetime) -> List[Dict[str, Any]]:
+    """Every signal_log row (each represents an attempted fire) inside
+    the window. Rotated + live logs are both read."""
+    out = []
+    for row in _iter_signal_log([SIGNAL_LOG_ROTATED, SIGNAL_LOG_LIVE]):
+        if _in_range(row.get("timestamp_open", ""), dt_from, dt_to):
+            out.append(row)
+    return out
+
+
+def _load_candidate_corpus(dt_from: datetime, dt_to: datetime) -> List[Dict[str, Any]]:
+    """Every corpus row (Phase 1 shadow orchestrator emits these once
+    detector migration is wired). In Batch 1 this file will be empty
+    until a live path is migrated."""
+    if not CANDIDATE_CORPUS.exists():
+        return []
+    out = []
+    with CANDIDATE_CORPUS.open() as fh:
+        for line in fh:
+            try:
+                r = json.loads(line)
+            except Exception:
+                continue
+            ts = r.get("timestamp") or r.get("ts")
+            if _in_range(str(ts), dt_from, dt_to):
+                out.append(r)
+    return out
+
+
+def _classify_match(
+    old_row: Dict[str, Any],
+    new_rows: List[Dict[str, Any]],
+) -> Dict[str, Any]:
+    """Placeholder classification for Batch 1.
+
+    Because the orchestrator is not yet wired to legacy dispatch paths,
+    the harness cannot fabricate a NEW-would-approve decision without
+    the raw candidate snapshot. Rather than invent one, we mark every
+    row 'deferred_to_batch_2' and defer the actual diff.
+
+    When Batch 2 wires migration (SHADOW-only), the corpus will contain
+    a row for every candidate the orchestrator saw; the join key is
+    (epic, side, timestamp_open ± 5min).
+    """
+    return {
+        "match": "deferred_to_batch_2",
+        "explanation": (
+            "Batch 1 wires the orchestrator + gate + corpus writer. "
+            "The legacy dispatch paths in autobot.py are NOT yet "
+            "publishing candidates to orchestrator_v2.submit() (that "
+            "wiring is Batch 2's detector-migration matrix per Phase 1 "
+            "§5). Until then, the shadow corpus is empty for this "
+            "attempt and the harness cannot compute a diff."
+        ),
+    }
+
+
+def run(dt_from: datetime, dt_to: datetime, out_path: Path) -> Dict[str, Any]:
+    attempts = _load_signal_log_attempts(dt_from, dt_to)
+    corpus = _load_candidate_corpus(dt_from, dt_to)
+
+    rows: List[Dict[str, Any]] = []
+    for a in attempts:
+        r = {
+            "ts": a.get("timestamp_open"),
+            "epic": a.get("epic"),
+            "pair": a.get("pair"),
+            "strategy": a.get("strategy"),
+            "side": a.get("direction"),
+            "old_attempted": True,
+            "old_close_reason": a.get("close_reason"),
+            "old_pnl_pips": a.get("total_pnl_pips"),
+            "old_executed": a.get("total_pnl_pips") is not None,
+            "new_orchestrator_received": False,
+            "new_gate_decision": None,
+            "new_result": "DEFERRED_TO_BATCH_2",
+        }
+        r.update(_classify_match(a, corpus))
+        rows.append(r)
+
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    with out_path.open("w", encoding="utf-8") as fh:
+        for r in rows:
+            fh.write(json.dumps(r, sort_keys=True, default=str) + "\n")
+
+    summary = {
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "window_from": dt_from.isoformat(),
+        "window_to": dt_to.isoformat(),
+        "total_attempts": len(rows),
+        "exact_matches": 0,
+        "old_only_attempts": len(rows),
+        "new_only_approvals": 0,
+        "old_reject_new_approve": 0,
+        "old_approve_new_reject": 0,
+        "reason_code_differences": 0,
+        "duplicate_suppression_differences": 0,
+        "capacity_differences": 0,
+        "source_path_differences": 0,
+        "deferred_to_batch_2": len(rows),
+        "corpus_rows_in_window": len(corpus),
+    }
+    return summary
+
+
+def _parse_date(s: str) -> datetime:
+    return datetime.fromisoformat(s).replace(tzinfo=timezone.utc)
+
+
+def main(argv: Optional[List[str]] = None) -> int:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--from", dest="dt_from", default="2026-09-08",
+                   help="ISO date (inclusive). Default 2026-09-08.")
+    p.add_argument("--to", dest="dt_to", default="2026-09-12",
+                   help="ISO date (exclusive). Default 2026-09-12.")
+    p.add_argument("--out", default=str(
+        ROOT / "reports-public" / "phase1_parity_20260908_20260911.jsonl"
+    ))
+    p.add_argument("--list-attempts", action="store_true",
+                   help="Print signal_log attempts and exit.")
+    args = p.parse_args(argv)
+
+    dt_from = _parse_date(args.dt_from)
+    dt_to = _parse_date(args.dt_to)
+
+    if args.list_attempts:
+        for a in _load_signal_log_attempts(dt_from, dt_to):
+            print(
+                a.get("timestamp_open"),
+                a.get("pair"),
+                a.get("direction"),
+                a.get("strategy"),
+                a.get("total_pnl_pips"),
+                a.get("close_reason"),
+            )
+        return 0
+
+    out = Path(args.out)
+    summary = run(dt_from, dt_to, out)
+    print(json.dumps(summary, indent=2, sort_keys=True))
+    print(f"\nRows written: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
