def process_proposal(*,
                       recommendation: dict,
                       shadow_dir: pathlib.Path = SHADOW_DIR_DEFAULT,
                       candles: list[dict] | None = None,
                       now_utc: dt.datetime | None = None,
                       ) -> dict:
    """Idempotently register a proposal + run its lifecycle to the
    current clock. Returns an audit dict naming what happened.

    No position opens unless the recommendation is READY. Candle
    data defaults to the live rolling CSV; pass a candles list to
    override (used by tests + fixtures).
    """
    now = now_utc or dt.datetime.now(UTC)
    shadow_dir.mkdir(parents=True, exist_ok=True)
    dedup_path = shadow_dir / "shadow_dedup.json"
    proposals_path = shadow_dir / "shadow_proposals.jsonl"
    positions_path = shadow_dir / "shadow_positions.jsonl"
    closed_path    = shadow_dir / "shadow_closed.jsonl"
    lock_path = shadow_dir / "shadow_exec.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_fd = open(lock_path, "a+")
    try:
        fcntl.flock(lock_fd.fileno(), fcntl.LOCK_EX)
    except OSError:
        pass

    try:
        state = _load_dedup(dedup_path)
        scenario = recommendation.get("scenario") or {}
        scenario_id = scenario.get("scenario_id") or ""
        revision_idx = int(scenario.get("revision_idx") or 0)
        key = _dedup_key(scenario_id, revision_idx)

        # ---- 1) Idempotently create proposal row ---------------------
        if key not in state.get("proposals", []):
            prop_row = {
                "proposal_id": f"shadow-{key}",
                "key": key,
                "scenario_id": scenario_id,
                "revision_idx": revision_idx,
                "generated_at_utc": recommendation.get("generated_at_utc"),
                "recommendation": recommendation.get("recommendation"),
                "readiness": recommendation.get("readiness"),
                "reason": recommendation.get("reason"),
                "direction": recommendation.get("direction"),
                "entry": recommendation.get("entry"),
                "stop": recommendation.get("stop"),
                "target": recommendation.get("target"),
                "subsequent_reversal": recommendation.get("subsequent_reversal"),
                "publication": recommendation.get("publication"),
                "market_data_status": recommendation.get("market_data_status"),
                "scenario": scenario,
                "primary": recommendation.get("primary"),
                "created_at_utc": now.isoformat(),
            }
            _append_jsonl(proposals_path, prop_row)
            state.setdefault("proposals", []).append(key)
            action = "PROPOSAL_CREATED"
        else:
            action = "PROPOSAL_ALREADY_EXISTS"

        # Only READY proposals can open positions. Everything else is
        # recorded as a proposal and we stop here.
        if recommendation.get("readiness") != READY:
            _save_dedup(dedup_path, state)
            return {"action": action, "position": None,
                    "readiness": recommendation.get("readiness"),
                    "reason": recommendation.get("reason")}

        # Only one open position per scenario_id at any time.
        if scenario_id in state.get("open_positions", {}):
            open_rec = state["open_positions"][scenario_id]
            _save_dedup(dedup_path, state)
            return {"action": action, "position": "ALREADY_OPEN",
                    "open_rev": open_rec.get("revision_idx"),
                    "opened_at_utc": open_rec.get("opened_at_utc")}
        if scenario_id in state.get("closed_scenarios", {}):
            close_rec = state["closed_scenarios"][scenario_id]
            _save_dedup(dedup_path, state)
            return {"action": action, "position": "ALREADY_CLOSED",
                    "exit_reason": close_rec.get("exit_reason"),
                    "closed_at_utc": close_rec.get("closed_at_utc")}

        # ---- 2) Monitor entry ----------------------------------------
        entry_price = (recommendation.get("entry") or {}).get("price")
        stop_price = (recommendation.get("stop") or {}).get("price")
        target_price = (recommendation.get("target") or {}).get("price")
        direction = (recommendation.get("direction") or "").upper()
        if entry_price is None or stop_price is None or target_price is None:
            # Should have been filtered by readiness but defensively guard.
            _save_dedup(dedup_path, state)
            return {"action": action, "position": None,
                    "reason": "INCOMPLETE on second-pass check"}

        gen_at = recommendation.get("generated_at_utc") or ""
        try:
            gen_dt = dt.datetime.fromisoformat(gen_at.replace("Z", "+00:00"))
        except ValueError:
            _save_dedup(dedup_path, state)
            return {"action": action, "position": None,
                    "reason": "unparsable generated_at_utc"}

        if candles is None:
            candles = load_candles()
        post_bars = _candles_after(candles, gen_dt, now=now)

        entry_bar = None
        for c in post_bars:
            if _is_direction_bar_cross(c, direction, entry_price):
                entry_bar = c
                break

        if entry_bar is None:
            _save_dedup(dedup_path, state)
            return {"action": action, "position": "WAITING_FOR_ENTRY",
                    "reason": "no post-proposal bar met the entry trigger yet"}

        # ---- 3) OPEN position ----------------------------------------
        # Simulated entry at the bar's close (the simplest honest fill
        # on an M5 bar — this is a shadow trade, not a limit order).
        simulated_entry = entry_bar["c"]
        open_row = {
            "proposal_id": f"shadow-{key}",
            "scenario_id": scenario_id,
            "revision_idx": revision_idx,
            "direction": direction,
            "simulated_entry_price": simulated_entry,
            "stop_price": stop_price,
            "target_price": target_price,
            "entry_bar_ts_utc": entry_bar["ts_open"].isoformat(),
            "entry_confirmed_at_utc": entry_bar["ts_close"].isoformat(),
            "proposed_at_utc": gen_at,
            "opened_at_utc": now.isoformat(),
            "event": "OPEN",
            "execution_mode": "SHADOW_ONLY",
        }
        _append_jsonl(positions_path, open_row)
        state.setdefault("open_positions", {})[scenario_id] = {
            "revision_idx": revision_idx,
            "opened_at_utc": now.isoformat(),
            "entry_bar_ts_utc": entry_bar["ts_open"].isoformat(),
            "entry": simulated_entry,
            "stop": stop_price,
            "target": target_price,
            "direction": direction,
            "proposal_id": f"shadow-{key}",
        }

        # ---- 4) Monitor exit on bars strictly AFTER the entry bar ----
        monitor_bars = [c for c in candles
                         if c["ts_open"] > entry_bar["ts_open"]]
        exit_reason = None
        exit_bar = None
        for c in monitor_bars:
            hit_stop   = _bar_hits_stop(c, direction, stop_price)
            hit_target = _bar_hits_target(c, direction, target_price)
            if hit_stop and hit_target:
                exit_reason = "AMBIGUOUS_INTRABAR"
                exit_bar = c
                break
            if hit_stop:
                exit_reason = "STOP_HIT"
                exit_bar = c
                break
            if hit_target:
                exit_reason = "TARGET_HIT"
                exit_bar = c
                break
        # Compute MFE/MAE over the bars inclusive of entry bar + monitor.
        mfe, mae = _mfe_mae([entry_bar] + monitor_bars, simulated_entry, direction)

        if exit_bar is None:
            _save_dedup(dedup_path, state)
            return {"action": action,
                    "position": "OPENED_AWAITING_EXIT",
                    "entry_price": simulated_entry,
                    "entry_bar_ts_utc": entry_bar["ts_open"].isoformat(),
                    "mfe_pips_so_far": mfe,
                    "mae_pips_so_far": mae}

        # ---- 5) CLOSE position ---------------------------------------
        if exit_reason == "STOP_HIT":
            sim_exit = stop_price
        elif exit_reason == "TARGET_HIT":
            sim_exit = target_price
        else:  # AMBIGUOUS
            sim_exit = exit_bar["c"]  # neutral mid; result flagged AMBIGUOUS

        if direction == "SELL":
            gross_pips = round(simulated_entry - sim_exit, 1)
        else:
            gross_pips = round(sim_exit - simulated_entry, 1)
        if exit_reason == "AMBIGUOUS_INTRABAR":
            gross_pips_note = "AMBIGUOUS — stop AND target touched in same M5 bar; result cannot be assigned"
        else:
            gross_pips_note = None

        close_row = {
            "proposal_id": f"shadow-{key}",
            "scenario_id": scenario_id,
            "revision_idx": revision_idx,
            "direction": direction,
            "simulated_entry_price": simulated_entry,
            "simulated_exit_price": sim_exit,
            "stop_price": stop_price,
            "target_price": target_price,
            "exit_reason": exit_reason,
            "exit_bar_ts_utc": exit_bar["ts_open"].isoformat(),
            "closed_at_utc": now.isoformat(),
            "gross_pips": gross_pips,
            "gross_pips_note": gross_pips_note,
            "estimated_cost_pips": None,       # not available on this host
            "net_pips": None,                  # computed only if cost data exists
            "mfe_pips": mfe,
            "mae_pips": mae,
            "publication_decision_at_proposal":
                (recommendation.get("publication") or {}).get("decision"),
            "event": "CLOSE",
            "execution_mode": "SHADOW_ONLY",
        }
        _append_jsonl(positions_path, close_row)
        _append_jsonl(closed_path, close_row)

        # Remove from open map, record in closed map.
        state.setdefault("open_positions", {}).pop(scenario_id, None)
        state.setdefault("closed_scenarios", {})[scenario_id] = {
            "revision_idx": revision_idx,
            "exit_reason": exit_reason,
            "closed_at_utc": now.isoformat(),
            "proposal_id": f"shadow-{key}",
        }

        _save_dedup(dedup_path, state)
        return {"action": action,
                "position": "CLOSED",
                "exit_reason": exit_reason,
                "gross_pips": gross_pips,
                "mfe_pips": mfe,
                "mae_pips": mae}
    finally:
        try:
            fcntl.flock(lock_fd.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock_fd.close()


def summary(shadow_dir: pathlib.Path = SHADOW_DIR_DEFAULT) -> dict:
    """Dashboard-ready summary: pending / open / closed counts + rows."""
    proposals = _read_jsonl(shadow_dir / "shadow_proposals.jsonl")
    positions = _read_jsonl(shadow_dir / "shadow_positions.jsonl")
    closed    = _read_jsonl(shadow_dir / "shadow_closed.jsonl")
    state = _load_dedup(shadow_dir / "shadow_dedup.json")

    open_by_sid = state.get("open_positions") or {}
    closed_by_sid = state.get("closed_scenarios") or {}

    pending = []
    for p in proposals:
        sid = p.get("scenario_id")
        if sid in open_by_sid or sid in closed_by_sid:
            continue
        pending.append(p)

    open_positions = []
    for sid, info in open_by_sid.items():
        proposal = next((p for p in proposals if p.get("scenario_id") == sid),
                         None)
        open_positions.append({**(proposal or {}), "lifecycle": info})

    recent_closed = sorted(closed,
                             key=lambda r: r.get("closed_at_utc") or "",
                             reverse=True)[:10]

    gross_total = sum((r.get("gross_pips") or 0.0) for r in closed
                       if r.get("exit_reason") not in (None, "AMBIGUOUS_INTRABAR"))
    outcomes = {
        "target_hit": sum(1 for r in closed if r.get("exit_reason") == "TARGET_HIT"),
        "stop_hit":   sum(1 for r in closed if r.get("exit_reason") == "STOP_HIT"),
        "ambiguous":  sum(1 for r in closed if r.get("exit_reason") == "AMBIGUOUS_INTRABAR"),
    }

    return {
        "schema": "shadow_exec.panel.v1",
        "pending_proposals": pending,
        "open_positions": open_positions,
        "recent_closed": recent_closed,
        "totals": {
            "proposals":   len(proposals),
            "open":        len(open_positions),
            "closed":      len(closed),
            "pending":     len(pending),
            "gross_pips":  round(gross_total, 1),
            "outcomes":    outcomes,
        },
        "execution_mode": "SHADOW_ONLY",
    }


