"""Scenario V2 shadow-execution lifecycle (research-only).

HARD CONTRACTS:
  * No IG client, no broker call, no trades-api endpoint, no AutoBot
    execution hook. The module imports NOTHING from /opt/tradingbot
    outside the research tree.
  * Append-only JSONL journals under
    ``research/live_obs/shadow_exec/``:
      - shadow_proposals.jsonl   one row per (scenario_id, revision_idx)
      - shadow_positions.jsonl   lifecycle events (OPEN, CLOSE)
      - shadow_closed.jsonl      flat closed-trade records
    plus ``shadow_dedup.json`` for key-level idempotency.
  * Lookahead-safe: a candle whose close is at or before the
    proposal's wall-clock generation time MUST NOT be used to confirm
    entry, stop or target. Only strictly-later bar closes contribute.
  * When stop and target are both touched inside the same M5 bar the
    outcome is AMBIGUOUS unless we have independent evidence of the
    intrabar order (we do not here).
  * Idempotent against service restarts: a proposal with the same
    (scenario_id, revision_idx) is NOT re-created; an open position
    whose scenario_id is already OPEN is NOT re-opened; a closed
    scenario cannot be re-closed.

The sweeper is invoked by a oneshot script (``shadow_exec/run_shadow_exec.sh``)
on a systemd timer or by the operator manually.
"""
from __future__ import annotations

import csv
import datetime as dt
import fcntl
import json
import pathlib
from typing import Any, Iterable

from scenario_recommendation import build_trade_recommendation, READY

UTC = dt.timezone.utc

SHADOW_DIR_DEFAULT = pathlib.Path(
    "/mnt/volume_lon1_1778405456698/research/live_obs/shadow_exec")
# Authoritative source — the primary observer's own OHLC stream.
# Each line is a snapshot for a completed M5 bar, with interactions[0].raw
# carrying open/high/low/close. Using this stream (instead of the rolling
# CSV at /opt/tradingbot/cache/) means the shadow executor and the AI
# agree on exactly which candles are completed.
SNAPSHOTS_PATH_DEFAULT = pathlib.Path(
    "/mnt/volume_lon1_1778405456698/research/live_obs/journal/snapshots.jsonl")
# Legacy fallback — kept so a host without the primary journal still has
# a path to candles. Lagging-by-one-bar risk is documented.
CANDLES_PATH_DEFAULT = pathlib.Path(
    "/opt/tradingbot/cache/GBPUSD_candles_rolling.csv")


# ---------------------------------------------------------------------
# Journals
# ---------------------------------------------------------------------

def _append_jsonl(path: pathlib.Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, default=str, sort_keys=True) + "\n")


def _read_jsonl(path: pathlib.Path) -> list[dict]:
    if not path.is_file():
        return []
    out: list[dict] = []
    with path.open("r", encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if not ln:
                continue
            try:
                out.append(json.loads(ln))
            except json.JSONDecodeError:
                continue
    return out


def _load_dedup(path: pathlib.Path) -> dict:
    if not path.is_file():
        return {"proposals": [], "open_positions": {}, "closed_scenarios": {}}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"proposals": [], "open_positions": {}, "closed_scenarios": {}}


def _save_dedup(path: pathlib.Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, sort_keys=True, indent=2),
                      encoding="utf-8")


# ---------------------------------------------------------------------
# Candle feed
# ---------------------------------------------------------------------

def load_candles(path: pathlib.Path = SNAPSHOTS_PATH_DEFAULT) -> list[dict]:
    """Return M5 OHLC rows sorted ascending by timestamp. Each row:
    ``{"ts_open": datetime, "ts_close": datetime, "o","h","l","c":float,
       "arrival_at_utc": datetime | None}``.

    Reads the primary observer's snapshots.jsonl by default — this is
    the SAME completed-bar stream the AI consumed when it generated
    each scenario, so no "waiting an extra candle" is required: once
    the observer appends a snapshot, the shadow executor sees it on
    the next sweep.

    A partially formed bar (i.e. one whose close time has not yet
    passed real wall-clock time) is EXCLUDED — snapshots are only
    written AFTER the bar closes, so this is a natural consequence
    of consuming the snapshot stream; the legacy CSV fallback below
    enforces it defensively via a now-check in the caller.
    """
    if not path.is_file():
        # Fallback to the legacy rolling CSV when running on a host
        # that lacks the primary journal. The CSV may lag by up to one
        # M5 interval; callers must still gate on now_utc.
        return _load_candles_csv(CANDLES_PATH_DEFAULT)
    out: list[dict] = []
    if path.suffix in (".jsonl", ".ndjson") or path.name.endswith("snapshots.jsonl"):
        with path.open("r", encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    d = json.loads(ln)
                except json.JSONDecodeError:
                    continue
                bar_ts = d.get("bar_ts_utc")
                inter = d.get("interactions") or []
                if not bar_ts or not inter:
                    continue
                raw = inter[0].get("raw") or {}
                try:
                    ts_open = dt.datetime.fromisoformat(
                        bar_ts.replace("Z", "+00:00"))
                    if ts_open.tzinfo is None:
                        ts_open = ts_open.replace(tzinfo=UTC)
                    arrival_s = d.get("received_at_utc")
                    arrival = None
                    if arrival_s:
                        try:
                            arrival = dt.datetime.fromisoformat(
                                arrival_s.replace("Z", "+00:00"))
                            if arrival.tzinfo is None:
                                arrival = arrival.replace(tzinfo=UTC)
                        except ValueError:
                            arrival = None
                    out.append({
                        "ts_open": ts_open,
                        "ts_close": ts_open + dt.timedelta(minutes=5),
                        "o": float(raw["open"]),
                        "h": float(raw["high"]),
                        "l": float(raw["low"]),
                        "c": float(raw["close"]),
                        "arrival_at_utc": arrival,
                        "source": "primary_snapshots",
                    })
                except (ValueError, KeyError, TypeError):
                    continue
    else:
        out.extend(_load_candles_csv(path))
    # Dedup by ts_open (snapshots.jsonl may contain multiple writes per
    # bar when the primary observer restarted mid-session; keep the
    # last-seen row).
    uniq: dict[dt.datetime, dict] = {}
    for c in out:
        uniq[c["ts_open"]] = c
    return sorted(uniq.values(), key=lambda c: c["ts_open"])


def _load_candles_csv(path: pathlib.Path) -> list[dict]:
    """Legacy loader for the rolling CSV. Returns the same shape."""
    if not path.is_file():
        return []
    out: list[dict] = []
    with path.open("r", encoding="utf-8") as f:
        r = csv.DictReader(f)
        for row in r:
            ts_s = row.get("timestamp")
            if not ts_s:
                continue
            try:
                ts_open = dt.datetime.fromisoformat(ts_s)
                if ts_open.tzinfo is None:
                    ts_open = ts_open.replace(tzinfo=UTC)
                out.append({
                    "ts_open": ts_open,
                    "ts_close": ts_open + dt.timedelta(minutes=5),
                    "o": float(row["open"]),
                    "h": float(row["high"]),
                    "l": float(row["low"]),
                    "c": float(row["close"]),
                    "arrival_at_utc": None,
                    "source": "rolling_csv",
                })
            except (ValueError, KeyError):
                continue
    return sorted(out, key=lambda c: c["ts_open"])


def _candles_after(candles: list[dict], not_before: dt.datetime,
                     now: dt.datetime | None = None) -> list[dict]:
    """Lookahead-safe filter.

    Rules:
      1. The candle's close time must be strictly LATER than
         ``not_before`` (the proposal's generation timestamp or an
         entry bar's open).
      2. The candle's close time must be at or before NOW — a bar
         whose close is in the future hasn't completed; even if a
         downstream row contains hypothetical OHLC, we never treat it
         as decided. Snapshots.jsonl never contains open bars, but
         the CSV fallback can — this check is defensive.
    """
    now = now or dt.datetime.now(UTC)
    return [c for c in candles
            if c["ts_close"] > not_before and c["ts_close"] <= now]


# ---------------------------------------------------------------------
# Lifecycle logic
# ---------------------------------------------------------------------

def _dedup_key(scenario_id: str, revision_idx: int) -> str:
    return f"{scenario_id}|rev{revision_idx}"


def _is_direction_bar_cross(c: dict, direction: str, level: float) -> bool:
    """Did this bar's HIGH-to-LOW envelope touch ``level`` in the
    correct direction?

    SELL entry trigger: bar closes BELOW level.
    BUY  entry trigger: bar closes ABOVE level.
    """
    d = (direction or "").upper()
    if d == "SELL":
        return c["c"] < level
    if d == "BUY":
        return c["c"] > level
    return False


def _bar_hits_stop(c: dict, direction: str, stop: float) -> bool:
    d = (direction or "").upper()
    if d == "SELL":
        return c["h"] >= stop  # SELL stop ABOVE
    if d == "BUY":
        return c["l"] <= stop  # BUY stop BELOW
    return False


def _bar_hits_target(c: dict, direction: str, target: float) -> bool:
    d = (direction or "").upper()
    if d == "SELL":
        return c["l"] <= target  # SELL target BELOW
    if d == "BUY":
        return c["h"] >= target  # BUY target ABOVE
    return False


def _mfe_mae(candles: list[dict], entry_price: float, direction: str) -> tuple[float, float]:
    """MFE / MAE in pips given a list of post-entry bars."""
    if not candles:
        return (0.0, 0.0)
    d = (direction or "").upper()
    highs = max(c["h"] for c in candles)
    lows  = min(c["l"] for c in candles)
    if d == "SELL":
        mfe = round(entry_price - lows, 1)
        mae = round(highs - entry_price, 1)
    else:
        mfe = round(highs - entry_price, 1)
        mae = round(entry_price - lows, 1)
    return (mfe, mae)


