REGIME_ROUTER_ENGINE_ENABLED=0
REGIME_ROUTER_MANAGED_STRATEGIES=BB_REVERSAL,EMA_PULLBACK
# Pre-fire news blackout (mirror BB_PIERCE_RUN). Setup consumed on block.
