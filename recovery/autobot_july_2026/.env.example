BIG_REV_ENABLED=0
BB_REV_L_ENABLED=0
OVERNIGHT_SWEEP_ENABLED=0
BRIEFING_LIQUIDITY_OPENING_RANGE_ENABLED=0
BRIEFING_LIQUIDITY_EMA_PULLBACK_ENABLED=0
# EMA_PULLBACK disabled 2026-05-04 — GBPUSD_TREND_CONTINUATION now fills
