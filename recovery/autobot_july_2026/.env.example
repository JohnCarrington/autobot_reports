# GBPUSD_RAW_REVERSAL — bidirectional reversal at exhaustion
# (2026-04-28). Replaces BB_REVERSAL/EXHAUSTION_REVERSAL/BIG_REV plus the
# 4× gbpusd_* counter-trend variants on GBPUSD. Three setups (BB pierce+
# recover, engulfing+hold, curve+rejection) gated by four context filters
# (body slope, RSI lift, MACD decay, level proximity). 06:00-21:00 UTC,
# max 3 entries per direction per session, bypasses 120s pair cooldown
# and post-SL block by mode (handled in autobot.py / trade_executor.py).
GBPUSD_RAW_REVERSAL_ENABLED=0
# GBPUSD_BB_BOUNCE / BB_PIERCE_RUN (rewritten 2026-05-02). Two-candle
# pierce + rejection on GBPUSD 5m. SL=12p hard, TP_cap=80p with multi-tier
# trail (BE@20p, T2@40p -20p, T3@60p -25p), time stop 240m. Window
# 06:00-17:00 UTC. 30-min pre-news blackout for GBP/USD high-impact
# events. Per-direction slot enforcement (1 LONG + 1 SHORT max).
GBPUSD_BB_BOUNCE_ENABLED=1
# SL widened 12→20 2026-05-23 (Fix 1): give trades room past noise before +10p scale-out trigger.
GBPUSD_BB_BOUNCE_SL_PIPS=20
GBPUSD_BB_REVERSAL_SL_PIPS=20
# Rejection window — number of bars after a qualifying setup in which
# a rejection can fire. Set to 1 for the legacy single-bar behavior.
GBPUSD_BB_BOUNCE_REJECTION_WINDOW_BARS=3
# Back-inside check uses the CURRENT bar's BB (not the setup-bar's
# stale BB) with this many pips of tolerance. Set to 0 for strict
# at-or-inside; default 1.0p catches visual rejections right at the
# band edge during fast-expanding-band moves.
GBPUSD_BB_BOUNCE_REJECTION_TOLERANCE_PIPS=0.5
GBPUSD_BB_BOUNCE_WIN_START_H=6
# GBPUSD_TREND_CONTINUATION — re-enabled 2026-05-04 with 2-bar continuation
# entry. Original pullback-to-H1-EMA50 logic was structurally rare-firing
# (0 fires across 2026-04-30/05-01 in cold replay). 12-bar breakout
# variant also missed Thursday's grind (price never broke 60-min high
# by 1.5p). 2-bar continuation (close > prior bar high) catches the
# step-up pattern: 5-day replay 15 fires, 46.7% hit rate, +51.1p net,
# Thursday caught with 5 fires +51.7p. Per-H1-bucket dedup limits to
# one fire per direction per H1. Freshness window tightened to 2-6
# H1 bars (filter exhausted trends). News blackout + regime gate
# (mirror EMA_PULLBACK pattern).
GBPUSD_TREND_CONT_ENABLED=0
# Pre-fire news blackout (mirror BB_PIERCE_RUN / EMA_PULLBACK).
# DEAD — no consumer (trend-cont stripped); kept-as-0 for honesty
GBPUSD_TREND_CONT_NEWS_BLACKOUT_ENABLED=0
GBPUSD_TREND_CONT_PRE_MINUTES=30
# Regime gate — INVERSE of BB_PIERCE_RUN. GBPUSD only. Block on RANGE.
# DEAD — no consumer (trend-cont stripped); kept-as-0 for honesty
GBPUSD_TREND_CONT_REGIME_FILTER_ENABLED=0
# GBPUSD_TREND (gbpusd_trend.py — the cascade-driven trend strategy, NOT
# the _CONT variant above) self-dispatch gate. Added Stage 2 2026-05-22:
# GBPUSD_TREND is not a router strategy. =0 → the autobot.py wrapper
# evaluates + logs but does NOT call execute_trade (strategy dormant;
# trailing-stop/forensic machinery stays intact). =1 restores legacy.
# CLEAN RUN 2026-05-26: fire-live (autobot.py:3258-3259 elif branch executes execute_trade).
GBPUSD_TREND_SELF_DISPATCH=1
# GBPUSD_BB_REV_PAT (2026-05-04) — V-shaped + Arc reversal patterns on
# GBPUSD 5m. Designed to catch reversals that BB_PIERCE_RUN's strict
# pierce+rejection misses (no-pierce wicks, multi-bar curving stalls).
# SL is 12p, broker TP 100p sentinel, multi-tier briefing TP via
# trade_manager.select_tp_levels, time stop 240m. Window 06:00-17:00
# UTC, 30-min pre-news blackout, regime gate (TRENDING blocks).
# Co-fire suppression vs BB_PIERCE_RUN (3-bar window, same direction).
GBPUSD_BB_REVERSAL_PATTERNS_ENABLED=1
GBPUSD_BB_REVERSAL_V_ENABLED=0
GBPUSD_BB_REVERSAL_ARC_ENABLED=1
GBPUSD_BB_REVERSAL_REGIME_FILTER_ENABLED=true
EXHAUSTION_REVERSAL_PAIRS=EURUSD,USDJPY,USDCAD
# Disable the legacy GBPUSD-specific reversal variants — RAW_REVERSAL
