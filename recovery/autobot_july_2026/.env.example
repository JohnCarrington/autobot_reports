# BRIEFING_EXECUTION TP selection — use deepest plan target (targets[-1])
# rather than targets[0]. 2026-04-21 retrospective on 54 matched trades
# showed +64p aggregate improvement. GBPJPY pinned to targets[0] because
# its targets[-1] distance is too wide (median 36p stop-hunts before TP2).
BRIEFING_EXEC_USE_DEEPEST_TARGET=1
BRIEFING_EXEC_DEEPEST_TARGET_SKIP_PAIRS=GBPJPY

# BRIEFING_EXECUTION simple-exits (2026-04-21)
# Philosophy: BE rides from entry to briefing's deep target. Exits are
# limited to SL (broker), TP (broker), PRE_NEWS_CLOSE, and EOD close.
# Every other early-exit mechanism is env-gated off below. Flip any
# _ENABLED=1 to restore the legacy mechanism for debug / A/B.
# autobot TIME EXIT at plan's exit_time_utc
BRIEFING_EXEC_TIME_EXIT_ENABLED=0
# autobot INVALIDATION on 5M close past inv_price
BRIEFING_EXEC_INVALIDATION_ENABLED=0
# BRIEFING_EXEC_PROFIT_PROTECT_ENABLED removed 2026-05-23 — MPP stripped.
# trade_manager REGIME_MAX_HOLD (max-hold-minutes force close)
BRIEFING_EXEC_REGIME_MAX_HOLD_ENABLED=0
# autobot broker-side SL move to entry+1p at +12p
BRIEFING_EXEC_SOFTWARE_BE_AMEND_ENABLED=0
# exclude BE from NY_CLOSE sweep (EOD handles it)
BRIEFING_EXEC_SKIP_NY_CLOSE=1

# Pip tolerance on briefing plan invalidation. Plan only invalidates if
# close exceeds level by this many pips. Catches single-pip overshoots
# from market noise without killing setups that briefly wick beyond level.
# Default 5p; tighten to 3p if real invalidations are slipping through,
# loosen to 8p if valid setups are still being killed.
BRIEFING_INVALIDATION_TOLERANCE_PIPS=5

# Enable strict enforcement of LLM-specified composite entry triggers
# (entry_trigger_v2). When live, fires are blocked if any condition in
# the LLM's spec isn't satisfied at trigger time. Built dark Apr 25
# (commits 5b08693 + 7c65626 + 1e6f010), promoted live 2026-05-01
# after Path B fade-miss caused EURUSD offside trade.
# Values: off (default — legacy gating only), shadow (logs would-block
# but doesn't block), live (blocks).
BRIEFING_EXEC_TRIGGER_V2_MODE=live

# D1 trend veto on the BRIEFING_EXECUTION phase2_sweep_reclaim path.
# Per docs/phase2_loss_breakdown_2026-05-11.md: counter-trend PHASE2
# trades booked −183p over 30 days (45 trades, 25% WR). The veto
# blocks a fire when direction opposes D1 close-vs-EMA-21 (5-pip
# dead zone). Stale-cache (>48h) → soft-fail to ALLOW + Telegram
# alert. TREND_ENTRY path is NOT gated by design (audit showed CT
# was net +5p there over 14 trades). Set to 0 to disable.
# Disabled 2026-05-12 — superseded by producer-side daily-authoritative
# eff_bias + plan validator (Bug 1 completion). The producer no longer
# authors counter-trend plans for BRIEFING_EXECUTION to fire on, so the
# downstream veto is redundant.
BRIEFING_D1_VETO_ENABLED=0

# BRIEFING_EXECUTION EOD close — once-per-UTC-day sweep at BRIEFING_EXEC_EOD_CLOSE_UTC.
# Closes BE positions at market with reason=EOD_CLOSE. If the bot restarts
# after this time, today's close is skipped (not retroactive) — positions
# carry to tomorrow's scheduled time.
# STRANGLER OFF 2026-05-24: 21:00 EOD time-close; cuts gbpusd_trend (prefix-enrolled in _is_briefing_exec_mode at autobot.py:257)
BRIEFING_EXEC_EOD_CLOSE_ENABLED=0
BRIEFING_EXEC_EOD_CLOSE_UTC=21:00

# GBPUSD_BB_PREMIRROR_L — Pattern B (pre-pierce mirror) at lower BB
# Mean-reversion grinder LONG-only at lower BB, validation 26 trades 69% WR
# +80p over 20 days. Different shape from REV_L — near-band tweezer reversals
# without pierce.
# Disabled 2026-04-28: subsumed by GBPUSD_RAW_REVERSAL
BB_PREMIRROR_L_ENABLED=0
BB_PREMIRROR_L_RISK_GBP=5.0
BB_PREMIRROR_L_MAX_TRADES_PER_DAY=4
BB_PREMIRROR_L_MAX_SL_PIPS=25
BB_PREMIRROR_L_BAR_N_BODY_RATIO=0.50
BB_PREMIRROR_L_BAR_NP1_BODY_RATIO_OF_N=0.60
BB_PREMIRROR_L_BAND_PROXIMITY_PIPS=8
BB_PREMIRROR_L_MIRROR_TOLERANCE_PIPS=5
BB_PREMIRROR_L_WINDOW_START_UTC=06:45
BB_PREMIRROR_L_WINDOW_END_UTC=15:30

# GBPUSD_NY_CONTINUATION_L — NY-open momentum continuation (LONG-only)
# Validates 4 trades over 20 days, 75% WR, +68p net, +28p avgW.
# Sixth node in the GBPUSD net. Catches NY continuation of
# directional London sessions. Selective by design — fires
# ~4-6 times/month.
# Disabled 2026-04-28: subsumed by GBPUSD_RAW_REVERSAL
NY_CONTINUATION_L_ENABLED=0
NY_CONTINUATION_L_RISK_GBP=5.0
NY_CONTINUATION_L_LONDON_MIN_RANGE_PIPS=25
NY_CONTINUATION_L_LONDON_DIRECTIONAL_FRAC=0.70
NY_CONTINUATION_L_PULLBACK_FRAC=0.20
NY_CONTINUATION_L_RECOVERY_PIPS=5
NY_CONTINUATION_L_MIN_BODY_RATIO=0.50
NY_CONTINUATION_L_MIN_BAR_RANGE_PIPS=5
NY_CONTINUATION_L_MAX_SL_PIPS=25
NY_CONTINUATION_L_TP_EXTENSION_FRAC=0.50
NY_CONTINUATION_L_PULLBACK_TIMEOUT_UTC=14:00
NY_CONTINUATION_L_CONFIRMATION_TIMEOUT_MIN=60
NY_CONTINUATION_L_WINDOW_START_UTC=12:30
NY_CONTINUATION_L_WINDOW_END_UTC=15:30

# Sizing harmonisation 2026-04-28 — every strategy uses this fixed size.
# Risk-based sizing was removed from the gbpusd_* strategies; per-strategy
# RISK_GBP env vars are now dead config. Raised 1.0 → 2.0 on 2026-05-23 to
# feed the +10p / 50% scale-out (see SCALE_OUT_AT_10P_ENABLED below): trade
# opens 2 units, scale-out banks 1 at +10p MFE, runner of 1 continues to TP
# at BE risk. Margin scales linearly (~2x prior).
TRADE_SIZE=2.0

# +10p / 50% scale-out (2026-05-23). When ON: at +10p MFE the trade manager
# closes half the position (size=1 of the 2-unit deal via partial-close API)
# and amends the runner's broker SL to entry (BE). Runner keeps its original
# TP. Universal — applies to ALL strategies. Kill-switch: set to 0 to disable
# the trigger (positions then fall through to the default profit-protect
# branch: arm at PROFIT_LOCK_TRIGGER_PIPS=35p, floor at PROFIT_LOCK_FLOOR_PIPS=20p).
# The prior BB_BOUNCE +10p/+3p BE-stop branch (commit 1f33d75) was DELETED
# 2026-05-23 — this scale-out is the only +10p management.
SCALE_OUT_AT_10P_ENABLED=1
# 2026-06-12: lowered from default 10p to 8p after live observation —
# 12-Jun EMA_PULLBACK_L peaked at +8.1p bid-MFE and reversed without
# triggering the 10p partial. 8p captures that band while leaving the
# trade-management framework otherwise unchanged. Reverse by removing
# this line (default reverts to 10).
SCALE_OUT_TRIGGER_PIPS=8

# 2026-06-05: BB_BOUNCE runner trail (post-scale-out peak-pivot trail).
# Gated on scaled_out + be_amend_ok. Activate ≥+12p; lock = peak − 6p;
# ratchet up only; floor = entry (BE, set by scale-out's amend). Shares
# the single SL primitive with scale-out's BE move (_amend_broker_sl).
# See trade_manager._apply_bb_bounce_runner_trail.
#
# 2026-06-30 (afternoon, per-leg reconciliation): the morning's blanket
# trail-OFF (BB_BOUNCE_RUNNER_TRAIL_ENABLED=0) was based on a 30-min
# truncated peak-excursion calc. Honest full-window walk of 17
# BB_BOUNCE TRAIL_STOPs over 2026-06-16..30:
#   L: trail-on +61.0p vs BE+TP-off +0.0p  → L wins with trail ON
#   S: trail-on +113.2p vs BE+TP-off +300.0p → S wins with trail OFF
# So the gate is now per-leg. The old single flag BB_BOUNCE_RUNNER_TRAIL_ENABLED
# is no longer read by the code (kept commented for archival reference).
# BB_BOUNCE_RUNNER_TRAIL_ENABLED=0  # superseded
BB_BOUNCE_L_RUNNER_TRAIL_ENABLED=1
BB_BOUNCE_S_RUNNER_TRAIL_ENABLED=0
BB_BOUNCE_RUNNER_TRAIL_ACTIVATE_PIPS=12
BB_BOUNCE_RUNNER_TRAIL_OFFSET_PIPS=6

# Pair-concurrency caps (added 2026-04-28; raised 2026-05-02 for BB_PIERCE_RUN).
# Empty = unlimited.
# Pre-2026-05-02 values were 2/1, which blocked BB_PIERCE_RUN from firing
# alongside an existing GBPUSD position from another strategy
# (BRIEFING_EXECUTION, BB_REVERSAL pyramid, etc.). Raised here so the
# limit is enforced solely by the cross-mode position cap (8) rather than
# the per-direction cap.
GBPUSD_MAX_CONCURRENT=8
GBPUSD_MAX_PER_DIRECTION=5
EURUSD_MAX_CONCURRENT=6
EURUSD_MAX_PER_DIRECTION=4
USDJPY_MAX_CONCURRENT=
USDJPY_MAX_PER_DIRECTION=
USDCAD_MAX_CONCURRENT=
USDCAD_MAX_PER_DIRECTION=

# News strategy per-pair allowlists (added 2026-04-28). Empty = all pairs.
# Set to e.g. 'GBPUSD' on the live droplet for GBPUSD-only news trading.
NEWS_TICK_PAIRS=
NEWS_STRATEGY_PAIRS=

# NEWS_STRATEGY rebuilt 2026-04-29 as actuals-driven tick-level fade:
#   |dev| > 5%  → te_calendar=CONTINUATION → NEWS_TICK fires.
#   |dev| ≤ 5%  → te_calendar=IN_LINE/REVERSAL → NEWS_STRATEGY fades.
#   no actuals → both skip.
# NEWS_STRATEGY direction = opposite of chronological-first 5p extreme
# post-release. Entry triggered on tick-level break of post-spike
# consolidation high/low water mark. Observable-only by default during
# validation; promotion criteria: ≥5 events, ≥3 WOULD_FIRE, +EV,
# win-rate ≥50%, no >50p loss, manual chart review.
# Promotion note: flipped to 0 (live) 2026-05-28 after rebuild. Was 1 (observable) during validation.
NEWS_OBSERVABLE_ONLY=0
# 2026-06-29: loosen spike thresholds (15→10 range, 10→7 directional). 8 of
# 14 armed HIGH events this period timed out at SKIP_ARMED_TIMEOUT —
# Ifo / GfK / Building Permits / secondary PMIs move 6-10p and never
# trip the 15p/10p gate. HTF-leak fix (3ad16f4) means counter-trend
# fires now reach signal_log, so we can review the newly-admitted
# events on real fills. Gates only the ARMED→SPIKE_DETECTED transition
# in _detect_spike (news_strategy.py:524-525); SL/TP/sizing untouched
# (NEWS_FADE_MAX_SL_PIPS / NEWS_FADE_MAX_TP_PIPS unchanged below).
NEWS_SPIKE_RANGE_PIPS=10
NEWS_SPIKE_DIRECTIONAL_PIPS=7
NEWS_BREAK_PIPS=1.5
NEWS_FADE_MAX_SL_PIPS=25
NEWS_FADE_MAX_TP_PIPS=50
NEWS_CONSOLIDATION_TIMEOUT_SECS=3600
# NEWS_TICK pre-rebuild stall-and-confirm chase path. Default OFF;
# rebuild routes IN_LINE / no-actuals to NEWS_STRATEGY's fade. Set to 1
# to roll back to pre-2026-04-29 behaviour without code change.
NEWS_TICK_LEGACY_STALL_PATH=0

# Phase 4B shadow classifier: candle buffer + preload sized to clear the
# strictest indicator warmup (ATR_PCTL_14 needs 576 bars of rolling-window
# history). Pre-2026-04-29 default of 50 starved ema_stack_state /
# bb_width_pctl / atr_pctl on every bar.
CANDLE_BUFFER_BARS=600
PRELOAD_TARGET_5M_BARS=600

# ============================================================
# Trade-quality guards (build/trade-quality-guards 2026-04-30)
# Observable-only by default — log WOULD_BLOCK to
# logs/guards_observed.jsonl, never enforce until promotion.
# Applies to TREND_CONTINUATION, BRIEFING_EXECUTION, BRIEFING_SWEEP.
# NEWS_TICK / NEWS_STRATEGY / RAW_REVERSAL are explicitly exempt.
# ============================================================
GUARDS_ENABLED=1
GUARDS_OBSERVABLE_ONLY=1

GUARD_STALE_BRIEFING_ENABLED=1
GUARD_NEWS_BLACKOUT_ENABLED=1
GUARD_PRICED_IN_ENABLED=1

GUARD_STALE_BRIEFING_PIPS=50
GUARD_PRE_BLACKOUT_BUFFER_MINS=10
GUARD_PRICED_IN_PIPS=25
GUARD_PRICED_IN_LOOKBACK_MINS=30

# levels_proximity (feat/guards-levels-proximity 2026-04-30)
# Applied to TREND_CONTINUATION + 3CO. Blocks entries within N pips of a
# briefing level the trade direction would be passing through.
GUARD_LEVELS_PROXIMITY_ENABLED=1
GUARD_LEVELS_PROXIMITY_PIPS=3

# === V1 Simplification 2026-05-19: Explicit disables for code-default-ON strategies ===
# CLEAN RUN 2026-05-26: mute cascade fade so only gbpusd_trend + gbpusd_bb_bounce fire.
BB_PATTERN2_FADE_ENABLED=0
FIFTY_PIP_BREAKOUT_ENABLED=0
RSI_EXTREME_FADE_ENABLED=0
MACD_EXTREME_FADE_ENABLED=0

# BB_3CANDLE_REVERSAL: module lives on branch pre-stripout-snapshot-20260521 (not HEAD); backtest reviewed 2026-05-23, +417p was outlier-carried (57% from W17) and scratch net of realistic exit-spread costs — NOT revived.
# DEAD — no consumer; v2 never wired
BRIEFING_EXECUTION_V2_ENABLED=0

# === REGIME SHADOW CLASSIFIER PROVENANCE (Stage 1.5, 2026-05-21) ===
# Tags every row in logs/regime_shadow.jsonl with source="live". systemd loads
# this file via EnvironmentFile=, so the value is present before autobot.py and
# the classifier module are imported. Offline analysis/replay/backtest scripts
# that import the classifier without this var set are tagged "analysis"
# automatically — see reports/regime_stage1_5_audit.md.
REGIME_SHADOW_SOURCE=live
# CLEAN RUN 2026-05-26: legacy filter from the PRE-REWRITE bb_bounce. Wrong-way for the
# counter-H1 fade (blocks LONG when cascade=TREND_DOWN, but the fade REQUIRES H1 bearish +
# fresh downward pierce → cascade modally TREND_DOWN at fire = self-strangle). Disabled for
# the clean run alongside REGIME_FILTER + MACD_EXTENDED (already 0). Re-evaluate / purge in cleanup.
BB_BOUNCE_CASCADE_GATE_ENABLED=0
# 2026-05-28: H1-counter gate disabled. The 0.30 ceiling correctly protected
# 10:15 UTC (regime BEARISH + H1 BEARISH, both agreed) but no override could
# admit lagging-H1 reversal setups without firing on the bearish ones too.
# Gate off; relying on remaining structural gates (pierce geometry + rejection
# body + slot + contiguity). The M5-override added in code on top of this gate
# has also been backed out — only the env kill-switch remains as the lever.
# 2026-06-23: RE-ENABLED. 51-day BB_BOUNCE GBPUSD audit (N=65 longs / 63 shorts)
# showed h1_strength separates falling-knife losers (bearish H1, strength≥0.30:
# WR 21% / -101p net) from lagging-H1 bounce winners (bearish H1, strength<0.30:
# WR 60% / +140.8p net at +9.4p mean). Re-enabling at existing FLOOR=0.0 /
# CEILING=0.30 (code defaults, not overridden in .env). 5m fan flag was null
# in the audit — not adding it as a gate input. Exhaustion+H1 telemetry enabled
# alongside so future calibrations work from logged data instead of replay.
# 2026-06-23 OFF — short side miscosts with-trend shorts (blocked +17.65 winner + 14:45 trade); regime-driven routing to replace.
GBPUSD_BB_BOUNCE_H1_COUNTER_GATE_ENABLED=false
# 2026-06-23: capture-only telemetry for EMA_PULLBACK fires. Logs the divergence
# / fan-state / H1 reads at every fire to logs/ema_pullback_exhaustion.jsonl.
# Gates nothing; helper code is the one committed in 8fa526d / 45d2ae4 / 3235877.
EMA_PULLBACK_EXHAUSTION_TELEMETRY_ENABLED=1
# 2026-05-28: shorten EMA_PULLBACK cooldown from 12 bars (60min) to 3 bars (15min).
# The 60-min lockout after the 10:35 UTC SHORT silently blanketed both directions
# through the 10:50 UTC bottom-and-rally. 15min keeps anti-revenge-trade protection
# while letting the opposite direction re-engage after a clear regime turn.
GBPUSD_EMA_PULLBACK_COOLDOWN_BARS=3
# 2026-05-28: lower BB_BOUNCE pierce magnitude floor from 2.0p to 0.5p.
# Today 10:50 UTC (11:50 BST): the actual band-pierce-and-reversal at the day's
# low had max pierce magnitude 0.94p — silently rejected by the 2.0p threshold
# (the function returns "" so no skip line is logged). 0.5p admits shallow
# touches on a band that's descending alongside price.
GBPUSD_BB_BOUNCE_PIERCE_THRESH_PIPS=1.0

# ════════════════════════════════════════════════════════════════════
# STRANGLER OFF — Batch 2 (2026-05-24)
# ════════════════════════════════════════════════════════════════════
# Trade-cutters/cappers that close or amend open positions the strategy
# didn't ask to touch. Same class as the 2026-05-23 entry-gate strip:
# selectivity belongs in the regime classifier + H1 + confirmation
# engine, NOT in mechanisms that cut/cap winners on the exit side.
# Disabling here so the clean run measures the new gbpusd_trend +
# gbpusd_bb_bounce strategies UNTOUCHED by inherited compensators.
#
# Re-confirm consumer locations (verified 2026-05-24):
#   SOFTWARE_BE_ENABLED        gates _apply_software_break_even at autobot.py:1794
#   NY_CLOSE_ENABLED           gates 16:55-end-window detection at autobot.py:1752
#   BB_PIERCE_RUN_TIME_STOP_MINUTES  drives BB_PIERCE max_hold at trade_manager.py:2239
# STRANGLER OFF 2026-05-24: +12p breakeven-ratchet caps winners (MPP-shape). Selectivity belongs in the decision layer.
SOFTWARE_BE_ENABLED=0
# STRANGLER OFF 2026-05-24: 16:55 time-close cuts trades regardless of P&L.
NY_CLOSE_ENABLED=0
# REGIME_MAX_HOLD neutered for clean run (999999 = effectively infinite).
# Proper REGIME_MAX_HOLD_ENABLED kill-switch deferred to post-run cleanup.
BB_PIERCE_RUN_TIME_STOP_MINUTES=999999

# === CLEAN RUN CONFIG 2026-05-26 ===
# Self-dispatch fleet (gbpusd_trend + gbpusd_bb_bounce) fires freely; router OFF;
# regime classifier SHADOW (emit logs regime_engine.jsonl every 5M close, gates nothing).
# Router fleet + pattern2-fade OFF. EOD reconcile trades↔regime by timestamp+pair.
# The 5 flips for this run (each is set in-place above, this block is a marker):
#   REGIME_ROUTER_ENGINE_ENABLED  1 → 0  (line 261)
#   EMA_PULLBACK_ENABLED          1 → 0  (line 255)
#   BB_REVERSAL_ENABLED           1 → 0  (line 173)
#   BB_PATTERN2_FADE_ENABLED      1 → 0  (line 549)
#   GBPUSD_TREND_SELF_DISPATCH    0 → 1  (line 230)
# 2026-06-28: legacy _detect path OFF — only the armed-state machine
# places EMA_PULLBACK trades. Requires the master-gate split landed
# this same day (gbpusd_ema_pullback.py:1502 + 1564 guard).
GBPUSD_EMA_PULLBACK_ENABLED=0
GBPUSD_BB_REVERSAL_ARC_MIN_REVERSAL_BODY_PIPS=2.5
GBPUSD_TREND_FAST_CONTEXT_ENABLED=1
GBPUSD_TREND_ENABLED=0
HTF_REGIME_ENABLED=1
# 2026-06-04: switch htf_authority from shadow-log to enforcing.
HTF_AUTHORITY_ENABLED=1
# 2026-06-06: STRUCTURE-LEADS override (retired H1-LEADS / EMA-stack).
# Mirrors structure_exit's 5M close-break primitive on the 5M series; the
# side of the most-recent flip becomes the authority direction. Validated
# on 06-04 / 06-05 GBPUSD counterfactual: +£96 over both days
# (06-05 +£66.20, 06-04 +£29.80, 9 fires blocked / 14, no catastrophic
# whipsaw misfires).
HTF_AUTH_STRUCTURE_LEADS_ENABLED=1
# RANGE carve-out (2026-06-09): stand down the structure-leads override when
# the HTF call is RANGE, so mean-reversion strategies (BB_BOUNCE etc.) can fire
# on range days. Default OFF in code; flipped ON here after Monday's 3
# GBPUSD BB_BOUNCE LONG blocks (2 of 3 had htf_h1=RANGE without drift override).
HTF_AUTH_STRUCTURE_RANGE_STANDDOWN_ENABLED=1
# STRUCT_LEADS_N=5                          # prior-bar window (code default 5)
# STRUCT_LEADS_MIN_BREAK_PIPS=0             # decisiveness floor (code default 0)
# Exhaustion exemption (separate flag, default OFF). When ON, rescues a
# counter-structure fade if the 5M setup bar shows RSI divergence + a
# MACD-hist magnitude ≥ HIST_MIN. Validated rule on the 9-fire forensic
# (recovers +£53 of £63 winners; blocks all £159 losers).
HTF_AUTH_STRUCT_EXEMPT_ENABLED=1
HTF_AUTH_STRUCT_EXEMPT_HIST_MIN=0.5
# structure_break RANGE-branch exempt (2026-06-17). When ON, a structure_break
# fire whose direction aligns with the most-recent N-bar flip passes the
# RANGE_no_continuation veto — the break direction governs over RANGE.
# Affects ONLY GBPUSD_STRUCTURE_BREAK_L/_S; reversal modes (BB_BOUNCE etc.)
# keep the existing RANGE_STANDDOWN / RANGE_no_continuation behaviour
# untouched. Counter-break direction and structure_dir=FLAT still BLOCK.
STRUCTURE_BREAK_HTF_RANGE_EXEMPT_ENABLED=1
# 2026-06-18: ADX-floor RANGE→TREND override for htf_authority._classify_market.
# When the H1 EMA classifier returns RANGE but the 5M regime_engine reports
# ADX>=HTF_AUTH_ADX_TREND_FLOOR, promote call=TREND with direction from
# structure_dir (preferred) or regime_engine.directional_bias. Symmetric:
# only flips RANGE→TREND, never touches TREND. Validated: rescues 17/17
# STRONG_TREND-while-RANGE cases in the 06-05..06-18 audit window with 0
# false positives (no RANGE/CHOP/COMP bars have ADX>=25 concurrent with
# htf_authority RANGE call). Set ENABLED=0 for instant kill-switch.
HTF_AUTH_ADX_OVERRIDE_ENABLED=1
HTF_AUTH_ADX_TREND_FLOOR=25.0
# 2026-06-06: passive news-state logger — attaches Finnhub economic-
# calendar context (news_state, impact, next release, pre-window flag) to
# every htf_authority.jsonl row. PURE TELEMETRY: no classifier or gate
# path reads news_* back; failure mode is news_state=UNKNOWN, no behaviour
# change. Once-per-day Finnhub fetch + disk cache (NOT per-fire).
NEWS_STATE_LOGGING_ENABLED=1
CONVICTION_ADX_GATE_ENABLED=0

# 2026-05-28 self-healing streamer live drop test — knobs (see streamer_ls.py)
MAX_TICK_AGE_SECS=180
LS_WATCHDOG_POLL_INTERVAL_SECS=5
LS_REOPEN_PROBE_DELAY_SECS=60
LS_RECONNECT_BACKOFFS=5,15,30,60,120,300
LS_LOG_LEVEL=WARN

# trades_api: switch /trades onto the IG-spine path (commit cdbfa73)
TRADES_USE_IG_SPINE=1
# 2026-06-06: bind the standalone trades-api.service to loopback only.
# nginx still proxies to it via 127.0.0.1:8080 — the public 8080 surface
# is gone. Reverts to public bind if this line is removed or set to 0.0.0.0.
TRADES_API_HOST=127.0.0.1

# EMA_PULLBACK H1 override (counter-H1 punch-through when regime says STRONG_TREND) —
# KILLED 2026-06-10 after fills review: OVERRIDE bucket n=4, zero positive expectancy,
# two -19.x losers incl. 2026-06-09 GBPUSD short into bullish H1. Code default is ON;
# this line must remain to keep it off.
EMA_PULLBACK_H1_OVERRIDE_ENABLED=0
# Fan-width gate live since 2026-06-09 restart (default true in code); explicit for visibility.
EMA_PULLBACK_FAN_GATE_ENABLED=1
# 2026-06-28: armed-state entry machine live. ENABLED gates calls to the
# armed path; SHADOW=0 means it can actually fire (audit-log only when 1).
EMA_PB_ARMED_MACHINE_ENABLED=1
EMA_PB_ARMED_MACHINE_SHADOW=0
# 2026-06-15 entry price = IG confirmed fill when available; see entry_price_source.
# When true, signal_log persists EPIC_STATE[pk]["entry_price"] (the IG broker
# fill captured by trade_executor.fetch_deal_by_deal_reference) tagged
# entry_price_source="ig_fill". When false / no fill / >5p from decision,
# persists the M5 decision price tagged "decision_fallback". See
# signal_logger.log_open docstring. Kill-switchable without code revert.
ENTRY_FILL_READBACK_ENABLED=true

# Enable gbpusd_structure_break (BoS momentum entry) — 2026-06-15.
# Transition filter + disp_confirm intentionally LEFT OFF for first-light
# (they log telemetry only — would_block verdicts accumulate without
# enforcing). Strategy commits: 5d3b4b0..8bd2410 on fix/bb-bounce-contiguity-guard.
STRUCTURE_BREAK_ENABLED=1
# Enforce signed-displacement entry confirmation — 2026-06-15. Default
# 6-bar window, 4p threshold. Telemetry-only mode validated on 06:05 UTC
# replay (disp=-9.10p, would_block_disp=False, entry would proceed).
STRUCTURE_BREAK_DISP_CONFIRM_ENABLED=1
# 2026-06-28: setup reduced to break-detection + displacement-confirm only.
# ADX floor disabled (set to 0). ADX from regime_engine is non-negative so
# `adx < 0` at gbpusd_structure_break.py:830 is never True → gate is a no-op.
STRUCTURE_BREAK_ADX_MIN=0
# 2026-06-28: decisive-break margin disabled. GRIND_ENABLED=1 lets us pin
# DECISIVE_PIPS=0; `break_pips < 0` at gbpusd_structure_break.py:818 is
# never True (break_pips is positive by the bars-replicate break check
# upstream) → gate is a no-op. A break is a break regardless of margin.
STRUCTURE_BREAK_GRIND_ENABLED=1
STRUCTURE_BREAK_DECISIVE_PIPS=0
# 2026-06-28: transition-chop filter explicitly disabled (was already
# default-off; pinning for safety so it can't be flipped on by env drift).
STRUCTURE_BREAK_TRANSITION_FILTER_ENABLED=0

# ── VWAP-STRETCH EXHAUSTION BRAKE (2026-06-30) ──────────────────────────
# Direction-aware brake on CONTINUATION strategies (STRUCTURE_BREAK,
# EMA_PULLBACK). 2026-06-30 swap: gate is now Kaufman ER (≤ER_MAX) +
# vwap stretch — the laggy CHOP-regime gate is GONE. Low ER = thrash /
# snap-back likely → brake fires. High ER = efficient / trend → brake
# stays out. Symmetric on both sides; the long side is back ON because
# the ER gate naturally spares efficient longs (14:55 SB_L at ER 0.885
# would be spared automatically without the old long-OFF hack).
# Fade strategies (BB_BOUNCE, CONFIRMATION_FALLBACK, BB_REV_PAT) are
# EXEMPT by mode-allowlist. Direction-matched. Flag-gated; read at call
# time. NO dependency on regime_engine for the gate.
TREND_STRETCH_BRAKE_ENABLED=1
# Kaufman ER gate. ER ≤ ER_MAX = thrash → block. ER > ER_MAX = efficient
# → spare. 0.70 / 10-bar window is the 2026-06-30 best-separating choice
# (L3/L4 at ER(10)=0.012 block; 14:55 SB_L at ER(10)=0.885 spared).
TREND_STRETCH_ER_MAX=0.70
TREND_STRETCH_ER_BARS=10
# SHORT side. 15p — note 2026-06-30 L2 at vwap_dist=-13.73p sits just
# ABOVE the threshold and is NOT caught at default. Lower to 13 or 14
# if L2 should be caught; that is a separate dial from the ER swap.
TREND_STRETCH_SHORT_PIPS=15
# LONG side. Symmetric default 15p. ER gate spares the 2026-06-30
# 14:55 SB_L +28p winner automatically (ER 0.885 > 0.70), so the old
# long-OFF hack is retired. TREND_STRETCH_LONG_ENABLED is now an
# operator kill-switch override; default ON.
TREND_STRETCH_LONG_PIPS=15
TREND_STRETCH_LONG_ENABLED=1

# ── RANGE GATE — 2026-06-30 live ──────────────────────────────────────
# Standalone range detector + suppression for the TREND family
# (STRUCTURE_BREAK, EMA_PULLBACK, TREND_V3). Mirror of the BB_BOUNCE
# STRONG_TREND stand-down, opposite direction. When the market is
# ranging (wide bands + low ER), TREND fires are false breakouts that
# revert — suppress them. Fade strategies (BB_BOUNCE, CONFIRMATION_
# FALLBACK, BB_REV_PAT) are EXEMPT by mode-allowlist.
# Range detected iff BOTH:
#   bb_w(20,2) >= RANGE_GATE_BBW_MIN AND ER(N) <= RANGE_GATE_ER_MAX
# Validated on 2026-06-30 11:35–13:20 range plateau (bb_w 22–24p, ER10
# 0.01–0.35): suppresses L3 SB_S + L4 EMA_PB_S; 14:55 SB_L (high ER)
# spared; chop squeeze (bb_w 5.7–6p) spared by the bb_w floor.
# Direction-agnostic. Read at call time. ADDITIVE to all other gates.
RANGE_GATE_ENABLED=1
# Wide-band threshold. 15p is the midpoint between today's chop squeeze
# (bb_w 5.7–6p) and today's range plateau (bb_w 22–24p).
RANGE_GATE_BBW_MIN=15
# Low-ER threshold. Today's range was ER10 0.01–0.35; the trend leg
# that produced the 14:55 SB_L +28p winner was 0.40–0.68. 0.35 is the
# clean separator.
RANGE_GATE_ER_MAX=0.35
# Kaufman ER lookback. 10 = the sharp read (ER20 carries residual
# trend leg and mis-reads the snap-back signature).
RANGE_GATE_ER_BARS=10

# Enable conviction-gate reversal-mode trend guard — 2026-06-15.
# Blocks BB-fade reversals against strongly-aligned trends:
#   LONG  blocked iff regime=STRONG_TREND_DOWN AND ADX>=25 AND EMA_state=BEAR_ALIGNED
#   SHORT blocked iff regime=STRONG_TREND_UP   AND ADX>=25 AND EMA_state=BULL_ALIGNED
# Pre-validation (06-01..06-15): 6/9 counter-trend longs blocked, 0/7 with-trend
# fires touched. Telemetry was on (would_block logged) before enforcement.
STRUCTURE_REVERSAL_TREND_GUARD_ENABLED=1
# ADX-slope override (2026-06-16) — when ADX has FALLEN by >= SLOPE_DELTA over
# the trailing LOOKBACK bars, the trend is dying and the fade is exactly the
# setup we want. Override the level-only block in that case. SLOPE_ENABLED=0
# reproduces the legacy level-only behaviour byte-for-byte.
STRUCTURE_REVERSAL_TREND_GUARD_SLOPE_ENABLED=1
TREND_GUARD_ADX_LOOKBACK=1
TREND_GUARD_ADX_SLOPE_DELTA=0.5
# Always-on telemetry — appends one row per reversal-guard eval to
# logs/trend_guard_shadow.jsonl so old-vs-new divergence is measurable.
TREND_GUARD_SHADOW_ENABLED=1

# R1 LONG cascade-veto shadow on BB_BOUNCE_L (2026-06-16). Telemetry-only
# verdict of "skip LONG when cascade_label_at_fire == TREND_DOWN", from the
# 2026-05-29..06-16 win/loser split where this rule lifts WR 45→69% with
# +99p net at 10% winner FPR. Enforce flag stays 0 until ~10 shadow fires
# have been confirmed; flip to 1 to engage the live veto.
BB_BOUNCE_L_CASCADE_GUARD_ENABLED=0
BB_BOUNCE_L_CASCADE_GUARD_SHADOW_ENABLED=1
# macd_35_45_30 availability fix (2026-06-16). The bars list arrives capped
# at 60 from autobot.py:4018 but macd_35_45_30 needs slow+signal=75 → every
# forensic snapshot reported insufficient_history. With shadow=1 the
# forensic block widens its input from candle_builder directly so the
# real 35/45/30 values land in forensic_fires.jsonl AND the BB_BOUNCE_L
# cascade shadow row — telemetry only, does NOT feed any entry gate.
BB_BOUNCE_MACD_3545_SHADOW_ENABLED=1

# Buffer gap-backfill (commit f6035a8) — see autobot.py:348-385 and candle_builder.py:88-98
STRUCTURE_BUFFER_GAPFILL_ENABLED=1

# Cookie session signing key for the Flask dashboard auth. Generated
# 2026-06-16 (one-time, fixed literal). Restarting trades-api MUST NOT
# regenerate this — that would invalidate every signed-in browser.
DASHBOARD_SECRET_KEY=REPLACE_ME

# HTF authority flags — set 2026-06-22 (restart op)
BB_BOUNCE_TREND_CONFIRMED_ONLY=1
EMA_PULLBACK_HTF_EXEMPT_ENABLED=1
STRUCTURE_EXIT_WITH_TREND_SUPPRESS_ENABLED=1
REGIME_NEWS_AWARE_ENABLED=1
DIRECTION_ROUTER_SHADOW_ENABLED=1
DIRECTION_ROUTER_ENFORCE_ENABLED=0

# Velocity gates DISABLED 2026-06-26 — fired trades at band extremes / vetoed
# the best long bounce of the day. Backtesting that validated them is now
# known unreliable. (Module defaults are "1" — explicit "0" overrides.)
BB_BOUNCE_VELOCITY_GUARD_ENABLED=0
SB_VELOCITY_GATE_ENABLED=0
EMA_PB_VELOCITY_GATE_ENABLED=0

# Arm-and-wait state machine — replaces COUNTER-H1 CEILING-branch block
# with a 3-state machine driven by H1 MACD(35/45/30) hist + slope from
# regime_engine.latest_result(). Commit 87ef77a. ENABLED 2026-06-26.
# Other knobs (ARM_HIST_FLOOR=1.5, DRAIN_BARS=2, MAX_AGE_H1_BARS=6,
# REJECTION_WINDOW_5M_BARS=4) left at code defaults.
BB_BOUNCE_ARM_AND_WAIT_ENABLED=1

# 2026-06-29: CONFIRMATION_FALLBACK enabled live. Sweep → reclaim → M5-confirm
# sequencer (gbpusd_confirmation_fallback.py). Never run live before this.
# Race-proof dispatch + signal_log-wired post-decision pipeline shipped
# in commit 1bec79a (callback _on_5m_close_confirmation_fallback). SHADOW
# explicitly OFF — live, not shadow telemetry. First real fills to be
# reviewed. Co-fire-with-BB_BOUNCE on the same sweep is a known
# unsuppressed risk being watched on first fires (BB_BOUNCE armed setups
# can sit on the same level CF arms a sweep on; the per-mode slot gate
# allows both to open as distinct modes). Regime self-gate keeps CF
# inside non-trending regimes (CHOP / COMPRESSION / RANGE_ROTATION /
# VOLATILITY_EXPANSION / etc.) so the overlap window is bounded.
CONFIRMATION_FALLBACK_ENABLED=1
CONFIRMATION_FALLBACK_SHADOW=0

# ── Regime engine near-zero band split (2026-07-01) ──────────────────
# Empirically-derived from trend-vs-chop |hist|/|slope| distributions.
# Prior default 1.0 (shared) was ~7x too high on hist, ~20x on slope for
# MACD(35/45/30) on H1 GBPUSD/EURUSD → 100% CHOP starving TREND_V3.
REGIME_MACD_NEAR_ZERO_HIST_THRESH=0.15
REGIME_MACD_NEAR_ZERO_SLOPE_THRESH=0.05
