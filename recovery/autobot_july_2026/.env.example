# CLOSE CONFIRMATION POLL
CLOSE_CONFIRM_RETRIES=3
CLOSE_CONFIRM_SLEEP_SECS=0.5
# NEWS BLACKOUT
# Global pre-news position-CLOSE kill switch (autobot.py:2368 block).
# Disabled 2026-05-23: its +10p keep-threshold collides with the universal +10p
# scale-out trigger, strangling winners at +8-9p. Re-enable to 1 only if new
# strategies prove news-vulnerable. Strategy-level entry-block (per-strategy
# *_NEWS_BLACKOUT_ENABLED) is a separate mechanism — leave those as-is.
PRE_NEWS_CLOSE_ENABLED=0
NEWS_BLACKOUT_ENABLED=0
NEWS_WINDOWS_FILE=/opt/tradingbot/news_windows.json
# Release-window suppressor (news_release_window.py): symmetric [-PRE,+POST]
# block around HIGH GBP/USD events from cache/news_state_finnhub_*.json.
# Block-entries-only — does not close open positions. Suppresses BB_BOUNCE,
# both EMA_PULLBACK paths, STRUCTURE_BREAK, and NEWS_STRATEGY_FADE.
# NEWS_STRATEGY_CONT bypasses (the +34.6p winning leg, allowed to trade).
NEWS_RELEASE_WINDOW_ENABLED=1
NEWS_RELEASE_WINDOW_PRE_MIN=30
# POST trimmed 40 → 25 (2026-07-01). 30-day audit of BB_BOUNCE
# pierce+rejection setups in data-release windows: the +25/+40 tail is
# empirically neutral (0W/0L over 2 fires, both timeout — vol has
# normalized, neither TP nor SL hit). +10/+25 KEEPS the blackout (20% WR,
# −4.4p/setup — where BB_BOUNCE bleeds on digested-print trends). Do NOT
# cut below 25. See /opt/tradingbot/_news_window_bb_audit.py.
NEWS_RELEASE_WINDOW_POST_MIN=25
NEWS_RELEASE_WINDOW_IMPACT=HIGH
NEWS_RELEASE_WINDOW_CURRENCIES=GBP,USD
# Per-category widths for actuals-less events (2026-07-01). Speeches and
# press conferences have no data print — NEWS_STRATEGY_CONT can't fire and
# FADE is a genuine loser (bench). Full data window kept for data releases.
# Module-load reads — restart required to change.
NEWS_RELEASE_WINDOW_SPEECH_PRE_MIN="0"
NEWS_RELEASE_WINDOW_SPEECH_POST_MIN="10"
NEWS_RELEASE_WINDOW_PRESSER_PRE_MIN="0"
NEWS_RELEASE_WINDOW_PRESSER_POST_MIN="15"
