# ════════════════════════════════════════════════════════════════════
# DEAD PER-TRADE GATES — pinned 0 for config-honesty (2026-05-24)
# ════════════════════════════════════════════════════════════════════
# Per-trade gates (bucket entry-limit, cooldown, post-SL block) STRIPPED
# BY DESIGN 2026-05-23 (commits 78d631e/3cfe634/56bb93c, "step 3g/3h/3j").
# Each gate was a hotfix patching poor strategy/regime behaviour;
# selectivity now lives in the regime classifier + H1 context + the new
# confirmation engine, NOT in entry gates. These vars are pinned 0 here
# so the code defaults (autobot.py:156=60, :165=1800, :334="1") cannot
# silently re-assert a dead gate's value if .env goes stale or a line
# is removed. The orphan reader functions remain in code — removal
# deferred to the post-clean-run purge.
#
# ⚠️ DO NOT FLIP ANY OF THESE TO 1 — the consumer code paths have been
# excised; a "=1" would silently set a config knob that nothing reads,
# and would re-introduce the lie this block was added to eliminate.
# (Historical cooldown tuning notes preserved below for archaeology.)
# DEAD — _entry_attempt_allowed_this_bucket has zero callers (G3 stripped 3cfe634)
ONE_ENTRY_PER_BUCKET=0
# DEAD as gate — _cooldown_ready only used for heartbeat display (G4 stripped 78d631e).
COOLDOWN_SECONDS=0
# Same-direction post-SL cooldown. Was 7200 (2 h) before 2026-04-30;
# shortened to 1800 (30 min) per dispatcher-decoupling. 60 s lets the bot
# revenge-trade the same losing setup within minutes (USDJPY 2026-04-15
# 08:21 SL → 09:03 SL). 30 min cools the immediate revenge response
# without freezing the strategy out of a same-day re-arm.
# ABOVE history retained for archaeology — gate dead as of 2026-05-23
# (G5 stripped 56bb93c): _sl_block_remaining has zero callers; _set_sl_block
# still writes _SL_BLOCKS but nothing reads it. Pinned 0 here.
COOLDOWN_SECONDS_AFTER_SL=0
TREND_FOLLOW_EXIT_MODE=FIXED
TREND_FOLLOW_ENABLED=0
