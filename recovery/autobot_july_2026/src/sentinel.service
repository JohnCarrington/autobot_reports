[Unit]
Description=Sentinel AI Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/tradingbot
EnvironmentFile=/opt/tradingbot/.env
ExecStart=/opt/tradingbot/venv/bin/python /opt/tradingbot/sentinel.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
