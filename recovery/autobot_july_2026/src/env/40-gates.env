# env/40-gates.env — gate & mode flags (layered config, per CLAUDE.md).
# This file is not auto-loaded by the systemd unit today; it is the
# authoritative documented source-of-truth for gate/mode flags. When the
# layered loader is wired, this file supplies the values below.

# STRUCTURE_BREAK entry-path mode (2026-07-25).
#   current       — no override, byte-identical to prior CHASE-hardcode.
#   prefer_retest — would-be CHASE from the classifier is routed via the
#                   existing retest machinery instead.
#   retest_only   — would-be CHASE flips are skipped (logged
#                   [SB-ENTRY] skipped=no_retest).
SB_ENTRY_PATH_MODE=prefer_retest

# NEWS_STRATEGY unified mode gate (2026-07-25, ITEM 2).
# Governs order emission for the tick-level spike-reactive path AND the
# release-anchored path (news_strategy_release_anchored.py).
#   off     — dormant (evaluate returns early, no order placed).
#   shadow  — full evaluation, eval rows written, zero orders.
#   enforce — evaluation + order via executor path (existing gates apply).
# Operator's Monday flip sequence: (1) enable refresh-news-calendar.timer;
# (2) set NEWS_STRATEGY_MODE=shadow; (3) restart. Enforce waits for eval
# evidence.
NEWS_STRATEGY_MODE=off

# Release-anchored evaluator parameters. Every value is ASSUMED per the
# spec (docs/NEWS_STRATEGY_BUILD_SPEC_2026-07-25.md) and revisited on
# shadow-mode eval evidence.
NEWS_MIN_IMPACT=HIGH
NEWS_DECISION_CANDLES=3
NEWS_SPIKE_MIN_PIPS=25
NEWS_FADE_BODY_PCT=0.50
NEWS_CONTINUATION_ENABLED=0
NEWS_SL_PIPS=20
NEWS_TP_PIPS=60

# BB_BOUNCE level-distance entry gate (2026-07-25). Promoted from
# telemetry per deduped-corpus n=124 evidence. Shadow-first — operator
# flips to enforce on Monday's healthy-feed WOULD_BLOCK evidence.
#   off     — no evaluation.
#   shadow  — log verdict, never block.
#   enforce — block on BLOCK verdict.
# Thresholds omitted from this file default to the code values
# (BB_BOUNCE_LEVEL_GATE_MAX_DIST_PIPS=8.0, TYPES=pdh,pdl,round_00,round_50);
# add explicit lines only if the operator overrides.
BB_BOUNCE_LEVEL_GATE_MODE=shadow

# NEWS_MOMENTUM observation-only strategy (2026-07-26).
# Observes the post-release RESOLUTION (30-60 min after the initial
# spike/retrace washes out). Separate from NEWS_STRATEGY — this is the
# instrumentation that will feed a future trade spec. `observe` is the
# ONLY implemented mode; `off` disables the sweep. `shadow`/`enforce`
# are RESERVED (no code path exists) — the observer treats them as
# `observe` for now. Trade logic is deliberately deferred until at
# least a fortnight of rows accumulate in
# logs/news_momentum_obs.jsonl.
NEWS_MOMENTUM_MODE=observe

# 2026-07-27: max-hold gated; flip to 0 ONLY after
# RUNNER_MOMENTUM enforce is proven on live runners
REGIME_MAX_HOLD_ENABLED=1
RUNNER_MOMENTUM_CHECK_MODE=shadow
