# env/10-infrastructure.env — telemetry paths & thresholds (layered config).
# This file is not auto-loaded by systemd today; it is the documented
# source-of-truth for telemetry infrastructure knobs. Wire via the layered
# loader when ready.

# NEWS_STRATEGY per-evaluation telemetry (2026-07-25).
NEWS_STRATEGY_EVALS_ENABLED=1
NEWS_STRATEGY_EVALS_LOG_PATH=/opt/tradingbot/logs/news_strategy_evals.jsonl

# News-calendar refresh timer (2026-07-25, ITEM 1b).
# NEWS_CALENDAR_REFRESH_HOURS is documented for reference; the actual
# cadence lives in deploy/systemd/refresh-news-calendar.timer's
# OnCalendar directive (Mon..Fri 00,04,08,12,16,20:00 UTC). Change
# both to keep them in sync.
NEWS_CALENDAR_REFRESH_HOURS=4
NEWS_CALENDAR_FETCH_TIMEOUT_S=15
NEWS_CALENDAR_LOOKBACK_DAYS=2
NEWS_CALENDAR_LOOKAHEAD_DAYS=7
# Staleness threshold used by news_calendar_health.age_hours() consumers
# (ITEM 1c). When the most recent cache/news_state_finnhub_*.json file
# is older than this, each consumer logs one WARNING per process life.
NEWS_CALENDAR_MAX_AGE_HOURS=24

# Bar-quality floor tripwire (ITEM 2 — 2026-07-25). Documents the
# defaults compiled into candle_builder.py; edit .env to override at
# runtime. All values are watch-and-shout only — none gate trading.
#   MIN_TICKS: bars with fewer ticks are logged at WARNING.
#   ALERT_CONSEC: N consecutive starved bars on one pair trip ONE Telegram.
#   ALERT_COOLDOWN_MIN: per-pair cooldown after a fired Telegram.
#   QUIET_UTC: no Telegrams during this UTC hour range ("start-end").
BAR_QUALITY_MIN_TICKS=10
BAR_QUALITY_ALERT_CONSEC=6
BAR_QUALITY_ALERT_COOLDOWN_MIN=60
BAR_QUALITY_QUIET_UTC=22-06

# Fires-silence watchdog (ITEM 3 — 2026-07-25). scripts/fires_watchdog.py
# reads these via os.getenv() when invoked from the daily timer. Values
# below match the compiled defaults; override in .env to retune without
# a code push. Watch-and-shout only.
#   MIN_AVG: strategies with trailing-avg >= this AND today=0 are digested.
#   TRAIL_DAYS: number of trading days used for the trailing average
#     (weekends and estate-wide zero-fill days are excluded from divisor).
FIRES_WATCHDOG_MIN_AVG=3.0
FIRES_WATCHDOG_TRAIL_DAYS=10

# NEWS_MOMENTUM observer thresholds (2026-07-26). Observation-only.
# All values are minutes-from-release, half-open windows:
#   PHASE A (settling range):   [+RANGE_START_MIN, +RANGE_END_MIN)
#   PHASE B (resolution watch): [+OBS_START_MIN,   +OBS_END_MIN)
#   PHASE C (outcome window):   from resolution close (or +OBS_END_MIN
#                               if none) to +OUTCOME_END_MIN
# Defaults chosen per operator's thesis: skip the first 5 minutes of
# spread-blown reaction, take the 5-30 minute window as the settling
# range, then watch 30-60 minutes for a 5m CLOSE beyond that range,
# then measure MFE/MAE out to 3 hours from release.
NEWS_MOM_RANGE_START_MIN=5
NEWS_MOM_RANGE_END_MIN=30
NEWS_MOM_OBS_START_MIN=30
NEWS_MOM_OBS_END_MIN=60
NEWS_MOM_OUTCOME_END_MIN=180
