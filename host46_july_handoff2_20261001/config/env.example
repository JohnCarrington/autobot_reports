# ======================================================================
# IG paired credentials — for the dashboard LIVE/DEMO toggle
# ======================================================================
# The trades-api dashboard (trades_api.py Part-3) can route /trades?env=
# through a per-env IG session. When env matches the host's IG_ACC_TYPE
# above, the existing singleton is reused (no second login). Otherwise
# the matching IG_<ENV>_* block below is used to build a fresh session.
#
# Missing creds for an env → that tab renders "ACCOUNT NOT CONFIGURED"
# (no exception, no silent fall-through to the other env's book).
#
# Master kill-switch: DASHBOARD_ENV_TOGGLE_ENABLED. With 0 (default)
# the ?env= query param is silently ignored and /trades behaviour is
# byte-equivalent to the pre-toggle dashboard. Flip to 1 to surface the
# LIVE/DEMO tabs.
DASHBOARD_ENV_TOGGLE_ENABLED=0
# DEFAULT_DASHBOARD_ENV=demo

# DEMO block (use these once you flip the toggle; values mirror IG_*
# above if this host is already DEMO).
# IG_DEMO_USERNAME=mrjohnnyb
# IG_DEMO_PASSWORD=XXXXXXXXXXXXXXXX
# IG_DEMO_API_KEY=cXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# IG_DEMO_ACCOUNT_ID=XXXXXXXX
# IG_DEMO_BASE_URL=https://demo-api.ig.com

# LIVE block — set ALL THREE of USERNAME/PASSWORD/API_KEY to enable
# the LIVE tab; ACCOUNT_ID + BASE_URL are optional. Leave blank to
# keep the LIVE tab in its explicit "not configured" state.
# IG_LIVE_USERNAME=
# IG_LIVE_PASSWORD=
# IG_LIVE_API_KEY=
# IG_LIVE_ACCOUNT_ID=
# IG_LIVE_BASE_URL=https://api.ig.com

