TELEGRAM_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxxx
ALERT_TP1_PARTIAL=1
ALERT_LIMIT_WINS=1
ALERT_UNKNOWN_CLOSE=0
