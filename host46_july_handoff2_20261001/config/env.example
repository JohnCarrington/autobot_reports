# Enforcement-lattice voice (2026-09-14 alert consolidation, alert_lattice.py).
# Behind this flag: (a) 00:05 canonical day-type line, (b) trend confirm/clear,
# (c) every ALLOWED candidate, (d) fired-then-rejected alarms (should be
# impossible), (e) 21:05 EOD one-liner. Reuses the existing Telegram helper.
ALERT_LATTICE=0
# Per-(type, dedup-key) rate limit in seconds. Fired-then-rejected alarms
# bypass this limit (dedup on deal_ref).
ALERT_LATTICE_RATE_LIMIT_S=300

# QM self-check calibration (2026-09-14). Grace bars = no zero-output alarm
# until this many 5m closes past process start (default 6). Sweep bars =
# further bars after grace before the sweep runs (default 3). Modules that
# provide a `trigger_seen` predicate report IDLE:awaiting_trigger instead of
# ERROR when the trigger has not yet occurred (e.g. exit_shadow while flat).
QM_SELFCHECK_ENABLED=1
QM_SELFCHECK_BOOT_GRACE_BARS=6
QM_SELFCHECK_BARS=3


