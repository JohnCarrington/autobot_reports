# ======================================================================
# PIA_FIRST briefing system (new bespoke producer + executor, 2026-05-13)
# Daily LLM-authored trade plans for the AutoBot-PIA droplet
# (144.126.207.200). One plan per pair per day at 05:30 UTC, market entry
# on briefing publish, broker-side SL/TP, EOD close at 21:00 UTC.
# ======================================================================
PIA_FIRST_ENABLED=0
MIN_CONFIDENCE_PIA_FIRST=60
PIA_FIRST_SCHEDULE_UTC=05:30
PIA_FIRST_MODEL=claude-sonnet-4-6
PIA_FIRST_TEMPERATURE=0.3
PIA_FIRST_MAX_TOKENS=400


# ======================================================================
# Lightstreamer self-healing controller (port from PIA, 2026-05-28).
# Watchdog detects silent feed death (heartbeat says alive, ticks stop)
# and forces re-auth + reconnect + re-subscribe-all-factories. Market-
# hours-gated so weekend tick gaps don't false-fire recovery.
# ======================================================================
# Max tick age (seconds) before the watchdog trips into recovery while
# the FX market is open. 90s is conservative — quiet news patches stay
# below this without triggering.
MAX_TICK_AGE_SECS=90

# Watchdog poll interval (seconds). 5s reacts well below MAX_TICK_AGE.
LS_WATCHDOG_POLL_INTERVAL_SECS=5

# Sunday-reopen grace period (seconds). After the market clock flips
# closed→open, the watchdog waits this long before judging staleness
# (otherwise it instantly false-fires on Sun 21:00 UTC because the
# last-tick timestamps have been Friday 21:00 UTC for ~48 hours).
LS_REOPEN_PROBE_DELAY_SECS=60

# Comma-separated list of backoff delays (seconds) between recovery
# attempts. Each entry is one attempt; after the list is exhausted,
# recovery gives up and logs critical — service restart is required.
LS_RECONNECT_BACKOFFS=5,15,30,60,120,300

# LS library internal log level (DEBUG/INFO/WARN/ERROR/FATAL). WARN
# is enough in production — INFO is a firehose during normal cadence.
LS_LOG_LEVEL=WARN


# ======================================================================
# Scale-out (+Xp / 50% partial-close, post-2026-05-23 universal model).
# ======================================================================
# Master flag — when set to 1 (default), at +SCALE_OUT_TRIGGER_PIPS of
# bid-MFE for longs / ask-MFE for shorts, the trade manager closes
# SCALE_OUT_FRACTION of the position and amends the runner broker SL
# to entry (BE). Universal across all strategies.
SCALE_OUT_AT_10P_ENABLED=1

# Trigger pip distance for scale-out. Default 10 (matches the original
# +10p design). Lowered to 8 on host 161 from 2026-06-12 after a live
# EMA_PULLBACK trade peaked at +8.1p bid-MFE and reversed without
# triggering. Trigger basis is unchanged: bid for BUY, ask for SELL.
SCALE_OUT_TRIGGER_PIPS=8

# Fraction of opened size closed on scale-out (default 0.5 = half).
SCALE_OUT_FRACTION=0.5


# ======================================================================
# IG-close classifier (trail-aware, 2026-06-12).
# ======================================================================
# Master flag — when set to 1 (default), trade_manager._detect_ig_close_reason
# consults _PROFIT_MGMT_BY_EPIC[pos_key]["last_amended_sl_price"] before
# falling through to the catch-all "External/manual close detected" label.
# Recognises TRAIL_STOP / BE_STOP_POST_SCALEOUT / AMENDED_SL_HIT.
# Set to 0 to restore the pre-fix behaviour.
CLOSE_REASON_TRAIL_AWARE_ENABLED=1

# Tolerance (pips) for matching recorded close_price against the last
# broker-amended SL level. 3.0 covers typical spread + sweep-tick latency
# without false-matching on a true manual close.
CLOSE_REASON_MATCH_TOLERANCE_PIPS=3.0


# ======================================================================
# LEVEL LADDER (RUNBOOK §7). Strategy-agnostic RUNNING → ASSESS → EXTEND
# exit manager (level_ladder.py). OFF by default; opt-in per mode.
# ======================================================================
# Master switch. Default 0 in code (level_ladder.LADDER_ENABLED). Set to 1
# to enable the ladder for any mode in LADDER_MANAGED_MODES.
LADDER_ENABLED=0

# Comma-separated allowlist of mode names the ladder is authorised to
# manage. Only the trend book at first activation (RUNBOOK §7 spec).
# LEVEL_BOUNCE L/S deliberately NOT in this list until the initial
# EMA_PB / TREND_V3 corpus lands.
LADDER_MANAGED_MODES=GBPUSD_EMA_PULLBACK_L,GBPUSD_EMA_PULLBACK_S,GBPUSD_TREND_V3_L,GBPUSD_TREND_V3_S

# Tunables — code defaults apply if omitted.
# LADDER_AT_LEVEL_PIPS=5
# LADDER_ASSESS_BARS=3
# LADDER_STOP_BUFFER_PIPS=3
# LADDER_MANAGED_BROKER_TP_PIPS=100


# ======================================================================
# TREND_V3 session gate (commit 2c950cd, 2026-07-21). Entries-only —
# monitor_exits/management of open positions never see this gate.
# ======================================================================
TREND_V3_SESSION_GATE_ENABLED=1
TREND_V3_SESSION_START_UTC=07:00
# Widened 2026-08-21 from the original 16:00 to admit late-London / early-
# NY-close TREND_V3 eval windows. Downstream 20:40 UM flatten and NY_CLOSE
# machinery are independent.
TREND_V3_SESSION_END_UTC=20:00

# ======================================================================
# TREND SUB-TYPE + UM-variant grind routing (2026-08-22)
# ======================================================================
# regime_engine.classify_regime stamps a `trend_subtype` on every result
# when the winning regime is one of STRONG_TREND_{UP,DOWN} /
# TREND_FORMING_{UP,DOWN}. Values: "GRIND", "IMPULSE", or null.
#   GRIND iff  efficiency >= GRIND_EFF_MIN  AND  bar_size_ratio <= GRIND_BAR_RATIO_MAX
#   else IMPULSE
# The bar_size_ratio denominator (20-day median 5m range in pips) is
# recomputed nightly at 00:10 UTC by scripts/grind_baseline_recompute.py
# via the grind-baseline.timer systemd unit. If GRIND_BASELINE_PATH is
# missing OR its mtime is > GRIND_BASELINE_MAX_AGE_SECS old, subtype is
# null and the UM router fails closed (no UM fire).
GRIND_EFF_MIN=0.40
GRIND_BAR_RATIO_MAX=1.2
GRIND_EFF_WINDOW=36
GRIND_BAR_WINDOW=12
GRIND_BASELINE_PATH=/opt/tradingbot/data/grind_baseline.json
GRIND_BASELINE_MAX_AGE_SECS=172800    # 48h

# UM-variant consolidation-break entry — bars looking BACK from the
# current 5m entry candidate; entry fires on first close beyond the
# max(high)/min(low) of the last N COMPLETED bars.
TREND_V3_GRIND_CONSOL_BARS=4

# ======================================================================
# TIERED_RATCHET exit stack (2026-08-22)
# ======================================================================
# Alternative exit manager for ladder-enrolled trend modes. See
# tiered_ratchet.py + reports-public/ladder_real_fires_20260822 column
# (c) for the +318p delta vs recorded managed stack across 131 real
# fires.
#
# Selection is via exit_dress:
#   * Per-mode direct override (highest priority):
#       EXIT_STACK_<MODE>=TIERED_RATCHET
#     e.g. EXIT_STACK_GBPUSD_TREND_V3_L=TIERED_RATCHET
#          EXIT_STACK_GBPUSD_TREND_V3_S=TIERED_RATCHET
#          EXIT_STACK_GBPUSD_EMA_PULLBACK_L=TIERED_RATCHET
#          EXIT_STACK_GBPUSD_EMA_PULLBACK_S=TIERED_RATCHET
#   * Per-day-context map (unchanged from 2026-08-22 day_ctx build):
#       DRESS_MAP_<LABEL>=MODE1:TIERED_RATCHET,MODE2:TIERED_RATCHET
#     e.g. DRESS_MAP_BIG_NEWS=GBPUSD_TREND_V3_L:TIERED_RATCHET,...
#   * Per-day-context default:
#       DRESS_DEFAULT_<LABEL>=TIERED_RATCHET
#
# All three default to empty — no mode resolves to TIERED_RATCHET
# until the operator sets one. exit_dress.resolve docstring documents
# the full precedence.

# Stop schedule — comma-separated "trigger_pips:lock_pips" pairs.
# Trigger is the favourable pips at which the tier fires; lock is the
# pip level (from entry) the software stop advances to. Sorted
# ascending internally. Stop only ever tightens.
RATCHET_TIERS=10:0,30:15,60:40,100:75

# Initial software stop distance from entry, in pips.
RATCHET_INIT_SL_PIPS=12

# Exhaustion — after this many consecutive 5m bars with no new
# favourable extreme AND software stop >= BE (BUY) / <= BE (SELL) →
# close, reason RATCHET_EXHAUSTION. Below BE, exhaustion never fires.
RATCHET_EXHAUST_BARS=6

# Hard session flat time (UTC HH:MM). Applied via the once-per-day
# sweep in autobot._apply_ratchet_eod_close, patterned on
# _apply_trend_v3_um_eod_close.
RATCHET_FLAT_HHMM=20:40
# Kill switch for the flatten sweep (1=on, 0=off).
RATCHET_FLAT_ENABLED=1

# Persistence + telemetry paths (change only if you know why).
RATCHET_STATE_PATH=/opt/tradingbot/cache/tiered_ratchet_state.json
RATCHET_TELEMETRY_PATH=/opt/tradingbot/logs/tiered_ratchet.jsonl

# ─── PHASE 1: Central Strategy Orchestrator / Execution Gate ──────────────
# Introduced 2026-09-11 (Phase 1 architecture refactor).
# See docs/master_spec_20260911.md §11, §47.
#
# BOTH default 0. Flip to 1 only after the Phase 1 parity report has
# been reviewed and accepted. In particular, do NOT flip either flag
# until:
#   * broker-open caller audit shows every live path routes through
#     CentralExecutionGate;
#   * 2026-09-08..09-11 four-day replay parity diff is clean
#     (all differences explained + evidenced);
#   * the phase-1 test suite passes.
#
# When 0 (default), the orchestrator + gate run in SHADOW mode:
# they observe live dispatches, populate the candidate corpus, and
# emit parity telemetry, but do NOT change live trading behaviour.
CENTRAL_STRATEGY_ORCHESTRATOR=0
CENTRAL_EXECUTION_GATE=0

# Shadow toggles — leave ON so corpus + parity data accumulates while
# the LIVE flags remain OFF. Setting these to 0 would kill telemetry.
CENTRAL_EXECUTION_GATE_SHADOW=1
ORCHESTRATOR_V2_SHADOW=1

# Reservation TTL — how long a gate reservation stays open awaiting
# a broker fill / rejection. Beyond this the reservation expires and
# the slot is released. Match to your worst-case broker latency +
# margin. 30s handles the observed 5–10s IG REST tail.
GATE_RESERVATION_TTL_SECONDS=30

# Corpus + instrumentation writer flags. Leave ON to accumulate data
# for the Phase 1 parity work and later ML.
CANDIDATE_CORPUS_WRITER_ENABLED=1
ENTRY_INSTRUMENTATION_ENABLED=1

# Log paths — do not change unless your filesystem layout differs.
CANDIDATE_CORPUS_LOG_PATH=/opt/tradingbot/logs/candidate_corpus.jsonl
ENTRY_INSTRUMENTATION_LOG_PATH=/opt/tradingbot/logs/entry_instrumentation.jsonl
DAY_TYPE_ADAPTER_LOG_PATH=/opt/tradingbot/logs/day_type_adapter.jsonl
# Phase 2 (spec §4–§8): activate canonical day-type routing (BIG_NEWS /
# BIG_NEWS_MINUS_1 / BIG_NEWS_PLUS_1 / MID_NEWS / NORMAL). Adapter still
# telemetric regardless; downstream routing consumers gate on this flag
# (Phases 4–8).
DAY_TYPE_ROUTER_V2=0
# Phase 3 (spec §12): mandatory observation. When 1, the
# central_execution_gate `observation` delegate rejects candidates whose
# per-symbol observation state is UNKNOWN (insufficient bars/time since
# session origin). When 0 the delegate STILL stamps
# observation:observation_ok / observation:insufficient_observation:...
# on every candidate — enforcement is what the flag gates. Defaults 0
# through Phase 3 (shadow); Phase 4–8 routing flips it.
OBSERVATION_GATE_ENABLED=0
# Configurable thresholds (defaults picked to match 30 minutes of 5m tape).
MIN_OBSERVATION_TIME_S=1800
MIN_OBSERVATION_BARS=6
OBSERVATION_STATE_PATH=/opt/tradingbot/cache/observation_state.json
# Phase 4 (spec §13–§18): news-family price-led trend router. When 1
# the central_execution_gate `news_direction` delegate rejects
# counter-trend candidates on news-family days (BIG_NEWS /
# BIG_NEWS_MINUS_1 / BIG_NEWS_PLUS_1 via day_type_adapter). When 0 the
# delegate stamps news_direction:direction_agree:* /
# direction_counter_trend:* / no_primary_direction:* /
# news_direction_off_route on every candidate but never rejects.
# Defaults 0 through Phase 4 (shadow). Phase 6 flips it in the slot
# machinery.
NEWS_TREND_ROUTER=0
# Classifier + state-machine thresholds. Defaults are the frozen
# values from Phase 4 Commit 4 calibration (see
# reports-public/news_trend_calibration_20260912.md); overrides here
# for A/B exploration.
NEWS_TREND_SWING_N=5
NEWS_TREND_MIN_STRUCTURE_BARS=12
NEWS_TREND_PERSIST_BARS=2
NEWS_TREND_EXTENDED_BARS=24
NEWS_TREND_WEAKENING_BARS=3

# ── Phase 5 news bounce / reversal route ─────────────────────────────
# Master flags for the news-family bounce/reversal route. Both default
# 0 (shadow only) through Phase 5. Phase 6 wires them into the slot
# machinery; consumption by TradeManager is Phase 10.
NEWS_BOUNCE_REVERSAL_ROUTE=0
NEWS_BOUNCE_CONFIRMATION=0
# §24 thresholds — frozen from Phase 5 Commit 4 calibration (see
# reports-public/news_bounce_calibration_20260913.md, winner combo
# 96% validation rate across 25 events on 32 news-family days,
# EXCLUDING 2026-09-10 per §124).
NEWS_BOUNCE_MIN_PIPS=5
NEWS_BOUNCE_MIN_CONFIRMATION_SCORE=4
NEWS_BOUNCE_MIN_DISPLACEMENT=8
# §24 additional envs (documented defaults; override only for A/B).
NEWS_BOUNCE_MIN_BARS=2
NEWS_BOUNCE_RETEST_REQUIRED=0
# Default excludes pivot_P per LEVEL_BOUNCE outer-levels precedent
# (gbpusd_level_bounce.py:402,412,431,442 — outer family = R1/R2/R3/S1/S2/S3;
# level_detector.py:98,124 — SRC_PIVOT_P is its own cohort, never pooled).
# Operator-overridable: empty value = allow all level types (A/B mode).
NEWS_BOUNCE_LEVEL_TYPES=pivot_s,pivot_r,round,pd
NEWS_REVERSAL_STRUCTURE_SHIFT_REQUIRED=1
NEWS_BOUNCE_EVENT_COOLDOWN=60
# Detector-internal geometry knobs.
NEWS_BOUNCE_ZONE_BAND_PIPS=5.0
NEWS_BOUNCE_LARGE_BODY_PIPS=4.0
NEWS_BOUNCE_HOVER_MIN_BARS=3
NEWS_BOUNCE_VELOCITY_CLOSE_PCT=0.20
NEWS_BOUNCE_SWEEP_MIN_PIPS=2.0

# ── Phase 6 news trade slots (§19 / §26 / §27) ──────────────────────
# Per-epic-per-UTC-day caps. Enforcement is master-flagged by
# NEWS_TREND_ROUTER (above) — these caps sit inert while the router
# is 0. Persistence file NEWS_SLOT_LEDGER_STATE_PATH is preserved
# across restart (§29); closing a trade does NOT restore capacity.
NEWS_PRIMARY_TRADE_CAP=1
NEWS_BOUNCE_TRADE_CAP=1
NEWS_TOTAL_TRADE_CAP=2
NEWS_SLOT_LEDGER_STATE_PATH=/opt/tradingbot/cache/news_slot_ledger.json

# ── Phase 6 release-proximity blackout ─────────────────────────────
# Blocks ANY slot consumption within ±(PRE,POST) of a HIGH-impact
# release today. Reuses news_release_window's Finnhub-cache release
# times — do not duplicate. Defaults 30/30 align with the existing
# NEWS_RELEASE_WINDOW_PRE_MIN so operator calendar edits propagate.
# Quarantine: bounce/reversal events confirmed ON a release bar are
# not consumable until they survive N × 5m bars past that release.
NEWS_RELEASE_BLACKOUT_ENABLED=1
NEWS_RELEASE_BLACKOUT_PRE_MIN=30
NEWS_RELEASE_BLACKOUT_POST_MIN=30
NEWS_RELEASE_BLACKOUT_BAR_TOLERANCE_MIN=5
NEWS_RELEASE_BLACKOUT_QUARANTINE_BARS=3

# ── Phase 7 MID_NEWS routing ───────────────────────────────────────
# MID_NEWS is now purely search/observation emphasis (A9.5, A10 A.2).
# It no longer disables any strategy family. The former MID_NEWS_ROUTER
# flag was deleted 2026-09-14 per A10 operator ruling — enforcement of
# suppressed families (e.g. BRIEFING_EXECUTION pending migration) now
# follows the general NORMAL_MARKET_ROUTER below.

# ── Phase 7/8 NORMAL-day routing ───────────────────────────────────
# NormalMarketState classifier (§32) — 4 states: UNKNOWN /
# PRODUCTIVE_RANGE / FLAT_OR_COMPRESSED / TRADABLE_NON_RANGE.
# Reuses regime_engine._range_features + _compression_chop_shadow;
# writes no new market maths. Router flag is stamp-only until
# Commit 4 wires it into the gate delegate.
NORMAL_MARKET_ROUTER=0
# Session anchor — later of UTC midnight and this hour. 06:00 UTC
# balances pre-London structure observation against Asia-session
# microstructure dilution (see normal_market_state.py header).
NORMAL_STATE_ANCHOR_HOUR=6
NORMAL_STATE_MIN_BARS=12
NORMAL_STATE_MIN_ENRICH_BARS=25
# Threshold envelope for the state partition. Commit 5 freezes final
# values against the Phase 2 ledger; these are the shipped defaults.
NORMAL_STATE_ER_MAX_RANGE=0.5
NORMAL_STATE_BB_MIN_RANGE_PIPS=8.0
NORMAL_STATE_CROSS_MIN_RANGE=2

# ── Phase 7/8 RangeQualityClassifier (§34–§35, §43) ────────────────
# Sub-classifier invoked when NormalMarketState = FLAT_OR_COMPRESSED.
# Decides PRODUCTIVE_RANGE vs CHOP_COMPRESSION with §43 recovery
# hysteresis. Router flag stamp-only until Commit 4 wires it in.
RANGE_QUALITY_CLASSIFIER=0
# CHOP_STANDDOWN: master flag for §42 stand-down enforcement in the
# gate delegate. Stamp-only until Commit 4.
CHOP_STANDDOWN=0
# Consecutive FLAT_OR_COMPRESSED bars before commit to CHOP.
RANGE_QUALITY_MIN_FLAT_BARS=3
# §43: "one large candle is insufficient" — 3 bars = 15 min at 5m.
RANGE_QUALITY_RECOVERY_MIN_CONSEC_BARS=3
# Productive discrimination inside the flat envelope.
RANGE_QUALITY_PRODUCTIVE_ER_MAX=0.4
RANGE_QUALITY_PRODUCTIVE_CROSS_MIN=3
# Recovery-evidence thresholds (per-bar signal for CHOP → PRODUCTIVE).
RANGE_QUALITY_CHOP_ER_MAX=0.25
RANGE_QUALITY_RECOVERY_CROSS_MIN=2
RANGE_QUALITY_RECOVERY_BBW_SLOPE_PPB=0.3
