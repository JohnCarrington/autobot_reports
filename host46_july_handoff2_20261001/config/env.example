TRADE_ENABLED_IN_TREND=TRUE


# ======================================================================
# LIQUIDITY SWEEP STRATEGY
# ======================================================================
# Market-context sweep veto.
# The veto fires when market_context detects one of four conditions that
# indicate the sweep is likely entering a ranging or trending-against market:
#   midrange_location      — price is in the middle 60% of its 30-bar range
#   volatility_expanding   — BB width is expanding (breakout, not reversal)
#   bandwalk_trend         — price has been hugging one band for 4+ of last 5 bars
#   aroon_macd_trend_momentum — MACD+Aroon aligned trend (only fires away from extremes)
#
#   0 = observe only: veto signal is logged and written to sweep_journal debug_json
#                     but the trade is never blocked. Use this to calibrate.
#   1 = hard block:   sweep signal is suppressed when veto fires.
SWEEP_VETO_ENABLED=0

# Sweep quality filter — three-phase gate applied after all existing guards.
# The filter is additive: it only adds a block, never removes one.
# All three phases must pass for the signal to reach execution.
#
# Phase 1 — Sweep depth: the sweep extreme must be this many pips beyond
#   the EMA-8/13/21 cluster midpoint. Guards against shallow, weak sweeps.
SWEEP_MIN_DEPTH_PIPS=20
#
# Phase 3 — Reversal candle quality: body + direction checks.
#   SWEEP_MIN_BODY_PCT: candle body must exceed this fraction of the candle range.
#   SWEEP_RSI_MIN_MOVE: RSI-3 must have moved at least this many points from its
#     10-bar extreme in the reversal direction (e.g. RSI rising from oversold for
#     a BUY sweep).
SWEEP_MIN_BODY_PCT=0.55
SWEEP_RSI_MIN_MOVE=15
#
# News-driven compression bypass: when news_day=True and sweep depth exceeds
#   this threshold, Phase 2 compression is skipped entirely. News spikes
#   produce sharp V-reversals that won't show accumulation candles; the depth
#   requirement compensates by demanding a larger dislocation.
NEWS_SWEEP_MIN_DEPTH_PIPS=50.0


# ======================================================================
# TREND_FOLLOW STRATEGY
# ======================================================================
# Exit mode for TREND_FOLLOW trades (replaces EMA_PULLBACK).
#   FIXED (default) — fixed 2:1 TP identical to legacy EMA_PULLBACK behaviour.
#   TRAIL           — manager-side trailing stop; fixed TP acts as emergency backstop.
TREND_FOLLOW_EXIT_MODE=FIXED

# Trailing stop parameters (only active when TREND_FOLLOW_EXIT_MODE=TRAIL).
# Trail arms once the trade has moved TREND_FOLLOW_TRAIL_ACTIVATE_PIPS in profit.
# Trail floor = best_pnl - TREND_FOLLOW_TRAIL_OFFSET_PIPS; breach closes the trade.
TREND_FOLLOW_TRAIL_ACTIVATE_PIPS=20
TREND_FOLLOW_TRAIL_OFFSET_PIPS=15
# Dynamic trail — when profit exceeds this threshold, use wider offset for strong trends.
TREND_FOLLOW_TRAIL_STRONG_ACTIVATE_PIPS=30
TREND_FOLLOW_TRAIL_OFFSET_STRONG_PIPS=25

# EMA pullback arm validity — structure-based with absolute backstop (candles).
EMA_PB_MAX_ARM_CANDLES=50


# Candles of continuous TREND_UP/TREND_DOWN regime before a trend is considered mature.
# A warning is logged once when this threshold is crossed; no action is taken yet (Phase 1).
TREND_MATURE_CANDLES=12

# Deep cache for HTF preloading — built by build_deep_cache.py (run manually).
# Number of 5M bars to fetch per symbol (2000 ≈ 7 trading days of H1/H4/D1 data).
DEEP_CACHE_BARS=2000


# ======================================================================
# GBPUSD BB_PIERCE_RUN (BB_BOUNCE)
# ======================================================================
# Cascade-disagree gate (wired 2026-05-12). Block LONG when the Phase 4B
# CandleRegimeClassifier cascade label is TREND_DOWN; mirror for SHORT.
# Allow on agreement, NEUTRAL, RANGE, missing, or stale (> 10 min) cascade.
# See docs/cascade_accuracy_join_2026-05-12.md §4.3. Set to 0 to disable.
BB_BOUNCE_CASCADE_GATE_ENABLED=1


# ======================================================================
# GBPUSD_TREND (cascade-driven trend strategy, 2026-05-13)
# ======================================================================
# Replaces gbpusd_trend_continuation + 3CO (both deleted 2026-05-13).
# Arms on Phase 4B cascade stable TREND_UP / TREND_DOWN at MEDIUM+
# confidence for 2 consecutive 5m closes; fires on the next 5m close
# that continues in the cascade-named direction. 12p fixed SL, no fixed
# TP — exits on cascade flip (2 consecutive non-matching emissions) or
# SL. MPP-exempt + BRIEFING_INVALIDATED-exempt. State persists to
# /opt/tradingbot/cache/gbpusd_trend_state.json via atomic write.
GBPUSD_TREND_ENABLED=true


