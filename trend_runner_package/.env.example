# Trend Runner – example environment file.
# Copy to /home/autobot/trend-runner/.env and edit for the destination droplet.
# NEVER commit secrets (IG_PASSWORD / IG_API_KEY / TELEGRAM_BOT_TOKEN) to git.

# ----- Storage -----
TREND_DATA_DIR=/home/autobot/trend-runner/data
TREND_LEDGER_PATH=/home/autobot/trend-runner/data/ledger.jsonl
TREND_OUTBOX_PATH=/home/autobot/trend-runner/data/telegram_outbox.jsonl
TREND_STATE_PATH=/home/autobot/trend-runner/data/state.json
TREND_LOCK_PATH=/home/autobot/trend-runner/data/trend-runner.lock
TREND_LOG_DIR=/home/autobot/trend-runner/logs

# ----- Instrument (GBPUSD MINI) -----
TREND_EPIC=CS.D.GBPUSD.MINI.IP
TREND_PIP_SIZE=1.0
# Broker minimum-distance. 4 pips is IG's usual GBPUSD MINI floor; adjust as required.
# The 12-pip figure hardcoded in production AutoBot is not IG's documented minimum –
# do not blindly copy it; validate against the operator's account.
TREND_MIN_BROKER_DISTANCE_PIPS=4
TREND_MIN_SIZE=0.5

# ----- Strategy -----
TREND_STAKE_GBP_PER_PIP=2
TREND_MAX_RISK_PIPS=30
TREND_MAX_LATE_ENTRY_PIPS=25

# ----- Execution (broker submission) -----
# Default is disabled. Must be flipped to 1 by the operator to allow REAL submissions.
TREND_EXECUTION_ENABLED=0
IG_ACCOUNT_TYPE=DEMO
IG_BASE_URL=https://demo-api.ig.com/gateway/deal
# Credentials belong in a secrets manager or environment overrides, NEVER in this file.
# IG_USERNAME=
# IG_API_KEY=
# IG_PASSWORD=

# ----- Recorder tail (observation mode) -----
TREND_USE_RECORDER_TAIL=1
TREND_RECORDER_PATH=/home/autobot/autobot/logs/price_streamer.jsonl

# ----- Telegram -----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
